---
import '../styles/global.css';
import media from '../data/media.json';

interface NavItem { label: string; href: string }
interface Props {
  title: string;
  description?: string;
  theme?: 'evera' | 'setkani' | 'kondept' | 'lasky';
  nav?: NavItem[];
  logo?: string;
  logoAlt?: string;
  homeHref?: string;
  cta?: NavItem;
  /** 'over' = průhledná hlavička přes tmavé hero, po odscrollování světlá */
  header?: 'solid' | 'over';
  /** úvodní preloader se sloganem a logem (jen hlavní stránka) */
  preloader?: boolean;
  /** Onesto: název stránky v editoru (např. „Hlavní stránka“). */
  onestoPage?: string;
  /** e-mail v patičce (stránky konference mají vlastní adresu) */
  contactEmail?: string;
}
const {
  title,
  description = 'Evera Agency – kongresy a konference v oblasti psychologie, psychoterapie a sociální práce.',
  theme = 'evera',
  nav = [
    { label: 'O nás', href: '/#o-nas' },
    { label: 'Konference', href: '/#konference' },
    { label: 'Kdo jsme', href: '/#kdo-jsme' },
    { label: 'Kontakt', href: '/#kontakt' },
  ],
  logo = media.logoEvera,
  logoAlt = 'Evera – event & travel agency',
  homeHref = '/',
  cta,
  header = 'solid',
  preloader = false,
  onestoPage,
  contactEmail,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
/**
 * Onesto (úpravy obsahu klientem): adresa aplikace a veřejný klíč webu z proměnných prostředí
 * (.env: PUBLIC_ONESTO_URL=https://…, PUBLIC_ONESTO_SITE=…). Bez nich se skript nevloží vůbec.
 */
const onestoUrl = (import.meta.env.PUBLIC_ONESTO_URL || '').replace(/\/+$/, '');
const onestoSite = import.meta.env.PUBLIC_ONESTO_SITE || '';
---
<!doctype html>
<html lang="cs" class={`theme-${theme}`}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#1d3a45" />
  {import.meta.env.BASE_URL !== '/' && <meta name="robots" content="noindex, nofollow" />}
  <title>{title}</title>
  {onestoPage && <meta name="onesto-page" content={onestoPage} />}
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="cs_CZ" />
  <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
  <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  {preloader && (
    <script is:inline>
      (function () {
        var h = document.documentElement;
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce) {
          h.classList.add('pre-on');
          // při obnovení začít nahoře, ne uprostřed stránky pod preloaderem
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
          window.scrollTo(0, 0);
        }
      })();
    </script>
  )}
</head>
<body>
  {preloader && (
    <div class="preloader" aria-hidden="true">
      <p class="pre-slogan">
        <span class="pl"><span>Vaše téma.</span></span>
        <span class="pl"><span class="pl-accent">Naše zkušenost.</span></span>
        <span class="pl"><span>Společný smysl.</span></span>
      </p>
      <img class="pre-logo" src={media.logoEvera} alt="" width="320" height="112" />
    </div>
  )}
  <a class="skip" href="#obsah">Přeskočit na obsah</a>
  <header class={`site-header ${header === 'over' ? 'over' : ''}`}>
    <div class="wrap bar">
      <a href={homeHref} class="brand" aria-label={logoAlt}>
        <img src={logo} alt={logoAlt} width="160" height="56" />
      </a>
      <nav aria-label="Hlavní navigace" class="menu">
        <button class="toggle" type="button" aria-expanded="false" aria-controls="nav-list" aria-label="Otevřít menu"><span></span><span></span></button>
        <ul id="nav-list">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          {cta && <li class="cta"><a class="btn" href={cta.href}>{cta.label}</a></li>}
        </ul>
      </nav>
    </div>
  </header>

  <main id="obsah">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap foot">
      <div class="foot-brand">
        <img src={media.logoEvera} alt="Evera" width="160" height="56" class="foot-logo" />
        <p data-edit="paticka.popis" data-edit-label="Patička (na všech stránkách): popis pod logem">Odborná setkání v oblasti psychologie, psychoterapie a sociální práce.</p>
      </div>
      <div class="foot-col">
        <span class="foot-label">Kontakt</span>
        <a href="tel:+420731573668" data-edit="paticka.telefon" data-edit-type="link" data-edit-label="Patička (na všech stránkách): telefon">+420 731 573 668</a>
        {contactEmail
          ? <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
          : <a href="mailto:info@evera.cz" data-edit="paticka.email" data-edit-type="link" data-edit-label="Patička (na všech stránkách): e-mail">info@evera.cz</a>}
        <span data-edit="paticka.adresa" data-edit-label="Patička (na všech stránkách): adresa">Branická 230/115, Praha 4</span>
      </div>
      <div class="foot-col">
        <span class="foot-label">Konference 2027</span>
        <a href="/setkani-v-pohybu/">Setkání v pohybu</a>
        <a href="/kondept2/">Kondept – dětská psychoterapie</a>
      </div>
    </div>
    <div class="wrap legal">
      <span>© {new Date().getFullYear()} Evera Agency s.r.o.</span>
      <span class="billing" data-edit="paticka.fakturace" data-edit-label="Patička (na všech stránkách): fakturační údaje"><span class="foot-label">Fakturační údaje</span>Evera Agency s.r.o.<br />Branická 230/115, Braník, 147 00 Praha 4<br />IČO: 22547827<br />DIČ: CZ22547827<br />Spisová značka: C 418273 vedená u Městského soudu v Praze</span>
    </div>
  </footer>

  <script>
    import Lenis from 'lenis';

    // Plynulý scroll – jen když uživatel nemá v systému omezené animace
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let lenis: Lenis | null = null;
    const headerH = () => (document.querySelector('.site-header') as HTMLElement | null)?.offsetHeight ?? 0;
    // výška toho, co je přilepené nahoře (hlavička + případně lišta kategorií) + vůle
    const stickyH = () => {
      const chips = document.querySelector('.chips-bar') as HTMLElement | null;
      return headerH() + (chips && getComputedStyle(chips).position === 'sticky' ? chips.offsetHeight : 0) + 16;
    };
    // Sjet na kotvu tak, aby byla NAHOŘE pod hlavičkou. Během scrollu se může obsah nad cílem
    // ještě natáhnout (dočítají se obrázky, písma), proto po dojetí polohu zkontrolujeme a dorovnáme.
    const goTo = (el: HTMLElement, smooth: boolean, tries = 3) => {
      // u sekce mířit na její nadpis, ne na horní okraj – jinak nad nadpisem zůstane celé odsazení sekce
      // a nadpis se zobrazí zbytečně nízko
      const t = (el.matches('section') && el.querySelector<HTMLElement>('h2')) || el;
      const fix = () => {
        const d = t.getBoundingClientRect().top - stickyH();
        if (Math.abs(d) > 4 && tries > 0) goTo(t, false, tries - 1);
      };
      if (lenis) lenis.scrollTo(t, { offset: -stickyH(), immediate: !smooth, force: true, onComplete: fix });
      else { window.scrollTo({ top: window.scrollY + t.getBoundingClientRect().top - stickyH(), behavior: smooth ? 'smooth' : 'auto' }); window.setTimeout(fix, smooth ? 900 : 50); }
    };
    const hashTarget = () => (location.hash.length > 1 ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null);
    if (!reduceMotion) {
      lenis = new Lenis({ duration: 1.15, smoothWheel: true });
      const raf = (t: number) => { lenis?.raf(t); requestAnimationFrame(raf); };
      requestAnimationFrame(raf);
      (window as any).__lenis = lenis;
      // Odkazy na kotvy na téže stránce (#x i /stranka/#x) posouvat plynule a pod hlavičku
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest?.('a[href*="#"]') as HTMLAnchorElement | null;
        if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || a.target === '_blank') return;
        const url = new URL(a.href, location.href);
        if (url.pathname !== location.pathname || url.origin !== location.origin) return;
        const target = url.hash.length > 1 ? document.getElementById(decodeURIComponent(url.hash.slice(1))) : null;
        e.preventDefault();
        if (target) goTo(target, true); else lenis?.scrollTo(0);
        history.pushState(null, '', url.hash || location.pathname);
      });
    }

    // Preloader: po doběhnutí animace ho odstraníme (do té doby se nescrolluje)
    if (document.documentElement.classList.contains('pre-on')) {
      lenis ? lenis.stop() : (document.documentElement.style.overflow = 'hidden');
      window.setTimeout(() => {
        lenis ? lenis.start() : (document.documentElement.style.overflow = '');
        window.setTimeout(() => document.querySelector('.preloader')?.remove(), 900);
        // pokud adresa obsahuje kotvu (#kontakt), po preloaderu na ni sjet
        const t = hashTarget();
        if (t) goTo(t, true);
      }, 3400);
    } else {
      document.querySelector('.preloader')?.remove();
      // příchod z jiné stránky rovnou na kotvu (/setkani-v-pohybu/#registrace): prohlížeč skočí dřív,
      // než se načtou obrázky a písma, a sekce pak sjede dolů – po načtení ji vrátíme nahoru
      if (hashTarget()) {
        const settle = () => { const t = hashTarget(); if (t) goTo(t, false); };
        if (document.readyState === 'complete') settle(); else window.addEventListener('load', settle, { once: true });
        document.fonts?.ready.then(settle);
      }
    }
    // Česká typografie: jednopísmenné předložky a spojky nenechávat na konci řádku
    const typography = () => {
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
      const re = /(^|[\s(„])([vkszouaiVKSZOUAI])\s+/g;
      for (let n = walker.nextNode(); n; n = walker.nextNode()) {
        const t = n.nodeValue;
        if (t && re.test(t)) n.nodeValue = t.replace(re, '$1$2 ');
        re.lastIndex = 0;
      }
    };
    typography();
    // Nadpisy s data-title: rozdělit na řádky po slovech kvůli maskovanému odhalení
    document.querySelectorAll<HTMLElement>('[data-title]').forEach((el) => {
      if (el.dataset.split) return;
      el.dataset.split = '1';
      const parts = [...el.childNodes];
      el.textContent = '';
      let li = 0;
      const addLine = (node: Node) => {
        const tl = document.createElement('span'); tl.className = 'tl';
        const inner = document.createElement('span'); inner.style.setProperty('--l', String(li));
        tl.style.setProperty('--l', String(li));
        inner.appendChild(node); tl.appendChild(inner); el.appendChild(tl);
        (inner as HTMLElement).style.transitionDelay = `${li * 90}ms`;
        li++;
      };
      parts.forEach((n) => addLine(n));
    });

    // Jemné odhalování obsahu při scrollu
    const revealSelector = '[data-reveal], [data-title], [data-img], [data-stagger]';
    const io = 'IntersectionObserver' in window
      ? new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io?.unobserve(e.target); }
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 })
      : null;
    const observeAll = () => {
      document.querySelectorAll<HTMLElement>(revealSelector).forEach((el) => {
        if (el.classList.contains('is-in')) return;
        if (io) io.observe(el); else el.classList.add('is-in');
      });
    };
    observeAll();
    // Onesto vložil uložený obsah (nové položky seznamů jsou nové prvky): znovu typografie a odhalování
    document.addEventListener('onesto:applied', () => { typography(); observeAll(); });
    // Stín hlavičky po odscrollování
    const header = document.querySelector('.site-header');
    const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    // Mobilní menu
    const toggle = document.querySelector<HTMLButtonElement>('.menu .toggle');
    const menu = document.querySelector('.menu');
    const setOpen = (open: boolean) => {
      menu?.classList.toggle('open', open);
      toggle?.setAttribute('aria-expanded', String(open));
    };
    toggle?.addEventListener('click', () => setOpen(!menu?.classList.contains('open')));
    document.querySelectorAll('.menu a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  </script>
  {onestoUrl && onestoSite && <script is:inline src={`${onestoUrl}/onesto.js`} data-site={onestoSite} defer></script>}
</body>
</html>

<style>
  /* ===== PRELOADER ===== */
  .preloader { display: none; }
  :global(html.pre-on) .preloader {
    position: fixed; inset: 0; z-index: 200; background: var(--ink); color: #fff;
    display: grid; place-items: center;
    animation: pre-out 0.9s cubic-bezier(0.76, 0, 0.24, 1) 3.4s forwards;
  }
  .pre-slogan, .pre-logo { grid-area: 1 / 1; }
  .pre-slogan {
    margin: 0; padding: 0 var(--gutter); text-align: center;
    font-family: var(--font-display); font-weight: 600; letter-spacing: -0.035em; line-height: 1;
    font-size: clamp(2.2rem, 6vw, 5.5rem);
    animation: pre-fade 0.5s ease 2.1s forwards;
  }
  .pl { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .pl > span { display: inline-block; transform: translateY(105%); animation: pre-line 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .pl:nth-child(1) > span { animation-delay: 0.15s; }
  .pl:nth-child(2) > span { animation-delay: 0.55s; }
  .pl:nth-child(3) > span { animation-delay: 0.95s; }
  .pl-accent { color: #f4a68e; font-weight: 300; }
  .pre-logo {
    width: clamp(11rem, 22vw, 18rem); height: auto; filter: brightness(0) invert(1);
    opacity: 0; clip-path: inset(0 100% 0 0);
    animation: pre-logo 1s cubic-bezier(0.22, 1, 0.36, 1) 2.4s forwards;
  }
  @keyframes pre-line { to { transform: none; } }
  @keyframes pre-fade { to { opacity: 0; transform: translateY(-12px); } }
  @keyframes pre-logo { to { opacity: 1; clip-path: inset(0 0 0 0); } }
  @keyframes pre-out { to { transform: translateY(-100%); visibility: hidden; } }

  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 1rem; top: 1rem; z-index: 100; background: #fff; padding: 0.5rem 1rem; }

  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    transition: box-shadow 0.4s var(--ease);
  }
  .site-header.scrolled { box-shadow: 0 8px 24px -18px rgba(29, 58, 69, 0.35); }
  .site-header.over { position: fixed; left: 0; right: 0; transition: background 0.4s var(--ease), box-shadow 0.4s var(--ease), color 0.4s; }
  .site-header.over:not(.scrolled) { background: rgba(10, 25, 30, 0.35); backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2); color: #fff; }
  .site-header.over:not(.scrolled) .brand img { filter: brightness(0) invert(1); }
  .site-header.over:not(.scrolled) .toggle { color: #fff; }
  .site-header.over:not(.scrolled) .menu li a:not(.btn) { color: #fff; }
  @media (max-width: 979px) { .site-header.over:not(.scrolled) .menu.open ul a:not(.btn) { color: var(--ink); } }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: var(--header-h); }
  .brand img { height: 3.9rem; width: auto; }
  @media (max-width: 979px) { .brand img { height: 3rem; } }

  .toggle {
    appearance: none; border: 0; background: none; cursor: pointer; width: 2.75rem; height: 2.75rem;
    display: grid; place-content: center; gap: 6px; border-radius: 999px; color: var(--ink);
  }
  .toggle span { display: block; width: 1.4rem; height: 1.5px; background: currentColor; transition: transform 0.4s var(--ease); }
  .menu.open .toggle span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .menu.open .toggle span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  .menu ul {
    list-style: none; margin: 0; padding: 0.75rem var(--gutter) 1.5rem;
    position: absolute; left: 0; right: 0; top: 100%;
    background: var(--paper);
    display: none;
  }
  .menu.open ul { display: block; animation: drop 0.45s var(--ease); }
  .menu li { margin: 0; }
  .menu li a:not(.btn) { display: block; padding: 0.7rem 0; text-decoration: none; font-weight: 500; }
  .menu li.cta { padding-top: 1rem; }
  @keyframes drop { from { opacity: 0; transform: translateY(-8px); } }

  @media (min-width: 980px) {
    .toggle { display: none; }
    .menu ul, .menu.open ul {
      position: static; display: flex; align-items: center; gap: 1.6rem;
      padding: 0; background: none; border: 0; animation: none;
    }
    .menu ul, .menu.open ul { gap: 2.4rem; }
    .menu li a:not(.btn) { padding: 0.3rem 0; border: 0; font-size: 1.0625rem; font-weight: 550; position: relative; }
    .menu li a:not(.btn)::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 1.5px;
      background: var(--accent); transform: scaleX(0); transform-origin: left;
      transition: transform 0.45s var(--ease);
    }
    .menu li a:not(.btn):hover::after { transform: scaleX(1); }
    .menu li.cta { padding: 0; }
  }

  .site-footer { background: var(--ink); color: #fff; padding-block: clamp(3rem, 6vw, 4.5rem) 2rem; font-size: var(--fs-sm); }
  .site-footer a { color: #fff; text-decoration: none; transition: opacity 0.2s; }
  .site-footer a:hover { color: #fff; opacity: 0.7; }
  .foot { display: grid; gap: 2.5rem; grid-template-columns: 1fr; }
  @media (min-width: 800px) { .foot { grid-template-columns: 2fr 1fr 1fr; } }
  .foot-logo { height: 3rem; width: auto; filter: brightness(0) invert(1); margin-bottom: 1rem; }
  .foot-brand p { color: rgba(255, 255, 255, 0.6); max-width: 22rem; margin: 0; }
  .foot-col { display: flex; flex-direction: column; gap: 0.45rem; }
  .foot-label { color: rgba(255, 255, 255, 0.5); margin-bottom: 0.3rem; }
  .billing .foot-label { display: block; }
  .legal {
    display: grid; grid-template-columns: 1fr; gap: 0.5rem 2.5rem;
    margin-top: clamp(2.5rem, 5vw, 4rem); color: rgba(255, 255, 255, 0.45); font-size: var(--fs-xs);
  }
  /* stejné sloupce jako horní část patičky – IČO/DIČ začíná pod „Konference 2027“ */
  @media (min-width: 800px) {
    .legal { grid-template-columns: 2fr 1fr 1fr; }
    .legal > span:first-child { align-self: end; }
    .legal .billing { grid-column: 2 / 4; }
  }
</style>

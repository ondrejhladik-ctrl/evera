---
import Base from '../../layouts/Base.astro';
import EventHero from '../../components/EventHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import m from '../../data/media.json';
import { NAV, ABSTRACT_URL } from '../../data/kondept';

const pillars = [
  ['Metody', 'Metody naší profese', 'Jak můžeme s dětmi pracovat, co pomáhá, z jakých teorií a výzkumů můžeme vycházet a o jaké principy se metodicky opírat – včetně využívání různých pracovních nástrojů a materiálů pro práci s dětmi s různými specifiky.'],
  ['Vztah', 'Vztahová rovina spolupráce s klienty', 'Jak zvyšovat důvěru a blízkost, zlepšovat kontakt, posilovat výživu, přijetí, péči a podporu ve vztahu s dětským klientem, jak zvládat přenosové a protipřenosové jevy, jak pracovat eticky a jak vztah ovlivňuje věk a vývojová fáze dětí.'],
  ['Rodina', 'Rodina dítěte', 'Spolupráce s rodiči, sourozenci a širší rodinou, se školou a širším kontextem dítěte – zvlášť ve specifických situacích, jako je náhradní rodinná péče, rozvod rodičů, vážná nemoc či úmrtí rodiče.'],
  ['Sebepéče', 'Sebepéče terapeuta', 'Co zažíváme my terapeuti v kontaktu s dětmi a rodiči a co potřebujeme, abychom mohli naši práci dělat co nejdéle a nejkvalitněji, cítili se při síle a chránili se před vyhořením.'],
];
const formats = [
  'Přednáška 45 min (30 + 15 min diskuse)',
  'Přednáška 90 min (75 + 15 min diskuse)',
  'Workshop 90 min',
  'Workshop 180 min',
  'Panelová diskuse 90 min',
  'Panelová diskuse 180 min',
];
const guidelines = [
  ['Nadpis abstraktu', 'max. 100 znaků'],
  ['Zkrácený nadpis do programu', 'max. 50 znaků'],
  ['Obsah abstraktu', 'max. 1 000 znaků; uveďte svůj vztah či zkušenost s tématem a zvýrazněte hlavní myšlenku'],
  ['Zkrácený obsah na web', 'max. 500 znaků'],
  ['Krátká biografie', 'max. 500 znaků; začněte jménem a příjmením včetně titulů (např. Mgr. Jan Novák, Ph.D. je psychoterapeut…)'],
  ['Fotografie', 'jpg nebo png, max. 300 kB, čtvercový formát'],
  ['Technické požadavky', 'notebook, dataprojektor, plátno, zvuk, internet apod.'],
  ['Uspořádání místnosti', 'divadlo, židle v kruhu, volný prostor bez židlí'],
  ['Redakční úpravy', 'abstrakty nebudou redigovány; autoři nesou plnou odpovědnost za obsahovou i formální správnost. Abstrakty můžete upravovat ve svém uživatelském účtu.'],
  ['Počet abstraktů a prezentujících', 'není omezen'],
];
const faq = [
  ['Kdy se konference koná?', '30. září – 2. října 2027 (čtvrtek až sobota).'],
  ['Kde se konference koná?', 'Ve čtyřhvězdičkovém Kongres Hotelu Jezerka na samotě u Sečské přehrady v Pardubickém kraji – komfortní místo se skvělým wellness centrem, obklopené přírodou.'],
  ['Jaká je kapacita konference?', 'Kapacita konference je 380 účastníků.'],
  ['Kdy konference začíná a končí?', 'Registrace a check-in v hotelu jsou od 11:00 (kartičky od pokojů od 15:00), oběd 12:00–13:30 je součástí poplatku. Zahájení je ve čtvrtek 30. září 2027 ve 13:30. Konference končí v sobotu 2. října 2027 ve 14:00, následuje volitelný oběd 14:30–16:00, který si objednáte při registraci.'],
  ['Je konference akreditovaná?', 'Konference je akreditována AKP ČR a ČLK JEP v rozsahu 21 vzdělávacích hodin. AKP ČR: pasivní účast 12 kreditů, aktivní 22 (12 + 10). ČLK JEP: pasivní účast 12 kreditů, aktivní 19 (12 + 7).'],
  ['Jak se mohu přihlásit na jednotlivé prezentace?', 'Přihlašování na přednášky a workshopy bude možné přes aplikaci Eventee od 1. září 2027.'],
];
const quotes = [
  ['Po stránce organizace jste odvedli skvělou práci do všech detailů. Muselo to stát mnoho úsilí.', 'Mgr. Silvie Ročovská, Ph.D.'],
  ['Ještě jednou moc děkujeme za skvělou organizaci, flexibilitu a ochotu – Vaši, dobrovolníků i pracovníků Jezerky.', 'Petra a Veronika'],
  ['Konference byla skvěle zorganizovaná, pestrá, přínosná i zábavná. Ráda přijedu zase. Ať se daří.', 'Eva Březinová'],
  ['Moc děkujeme za konferenci, která byla perfektně připravená a obohacující. Vyzkoušely jsme si náš formát a zjistily, že je potřeba více času. Budeme se těšit na příště.', 'Lenka Chválová'],
  ['Děkuji za skvěle zorganizovanou konferenci a velmi pěkný zážitek.', 'Radmila Pikorová'],
  ['Děkuji za úsilí, které jste vynaložili při organizaci konference. Nepadlo vniveč, ale na úrodnou půdu. Moc díky.', 'Kamil Janhuba'],
  ['Na konferenci mi bylo moc příjemně, děkuji a někdy zase na shledanou.', 'Jana Vraspírová'],
  ['Děkuji za skvělé zprávy i za uspořádání konference, kterou vnímám jako velmi obohacující. Už se těším na další ročník v roce 2027. Vše bylo perfektně vyladěné – zajímavé přednášky, workshopy, organizace, vynikající jídlo i dostupné ubytování. Děkuji za krásný zážitek a možnost setkání s kolegy v oboru.', 'Hana Kotálová'],
  ['Děkujeme za příležitost účastnit se konference. Bylo to velmi inspirativní a skvěle zorganizované setkání.', 'Michaela Širůčková'],
];
// všechny fotky z původní stránky (Ozvěny 2025)
const photos = ['2026/05/1470503', '2026/05/1470520', '2026/07/1500393', '2026/07/1470586', '2026/07/1470600', '2026/07/1470796', '2026/07/1500510', '2026/07/1500389-1', '2026/07/1490342', '2026/07/1490362', '2026/07/1500124', '2026/07/1480724', '2026/07/1490398', '2026/07/1480563', '2026/07/1500214', '2026/07/1500411', '2026/07/1490850'].map((n) => `/media/${n}-800x600.webp`).concat(
  // galerie „Fotografie Kondept“ ze starého webu
  'DSC_0642 DSC_0637-2 DSC_0641 DSC_0635 DSC_0625-2 DSC_0622 DSC_0607 DSC_0598 DSC_0600-2 DSC_0596 DSC_0592 DSC_0588 DSC_0590 DSC_0587-2 DSC_0585-2 DSC_0581-2'.split(' ').map((n) => `/media/2023/06/${n}.webp`),
);
const committee = ['Radka Faifrová', 'Ivana Fujanová', 'Petr Hrouzek', 'Veronika Kašparová', 'Michal Kniha', 'Barbora Křivanová', 'Ingrid Kubiszová', 'Sára Machová', 'Eva Naimanová', 'Kateřina Paclíková', 'Tereza Pojmanová Pandadis', 'Žaneta Říhová', 'Noemi Matějková', 'Lucia Šnajderová', 'Veronika Stoláriková', 'Jaroslav Vrba', 'Milena Kutlátková Nováková', 'Jakub Nepejchal'];
const students = 'Mgr. Markéta Bosáková, MDDr. Lenka Černá, MBA, Mgr. Anežka Dvořáková, Mgr. Marie Magdala Hluško, Mgr. Markéta Chrášťanská, Mgr. Dana Jakšičová, Mgr. Josef Janků, Mgr. Michaela Kotvová, Mgr. Adéla Kubalíková, Mgr. Michaela Kubínová, Mgr. Aneta Lingová, Mgr. Jana Macková, PhDr. Josef Mižigar, Mgr. Petra Nekulová, Mgr. Marie Nováková, Mgr. Lenka Pivodová, PhD., Mgr. Lada Sanvenero, Mgr. Marek Stránský, Mgr. Jana Švecová, Mgr. Ondřej Toth, Mgr. Kateřina Vápenková, Mgr. Aneta Viktorová';
const coordinators = [
  { img: m.kVavrova, name: 'Alena Vávrová', role: 'odborná koordinátorka', bio: 'Dětská psycholožka a psychoterapeutka, poradkyně pro rodiče a rodinná terapeutka, ředitelka Institutu dětského poradenství a terapie INDEPT s.r.o. Má soukromou praxi, věnuje se vzdělávání gestalt terapeutů a dětských psychoterapeutů v Čechách i v zahraničí a je supervizorkou dětských psychoterapeutů.', web: 'www.detsky-psycholog.cz' },
  { img: m.kCandia, name: 'Alžběta Candia Muñoz', role: 'odborná koordinátorka', bio: 'Psychodynamická psychoterapeutka a dětská, párová a rodinná gestalt terapeutka. Založila a dlouhá léta vedla organizaci HOST Home-Start ČR, působila i jako metodička asistovaných kontaktů a dětská terapeutka (2003–2023). Má 28 let praxe v práci s ohroženou rodinou. Má soukromou praxi a je členkou lektorského týmu INDEPT.', web: 'www.terapieacm.cz' },
  { img: m.kVavra, name: 'Jan Vávra', role: 'technický koordinátor', bio: 'Psychoterapeut a lektor zaměřený na rodičovské a komunikační dovednosti. Založil a několik let vedl Gordon Institut s.r.o. (kurzy P.E.T. a T.E.T.), je spoluautorem kurzů Rodičovství jako cesta a Rodičovská posilovna a moderuje stejnojmenný podcast. Pro INDEPT vyučuje téma rodičovství; pro konferenci zajišťuje technickou, marketingovou a programovou podporu.', web: 'www.gestalt-terapie.cz' },
];
---
<Base
  title="2. česká konference dětské psychoterapie 2027 | KONDEPT"
  description="2. česká konference dětské psychoterapie – Metody, vztah, rodina, sebepéče. 30. září – 2. října 2027, Kongres Hotel Jezerka, Seč."
  theme="kondept"
  onestoPage="Kondept"
  nav={NAV}
  logo={m.logoKondept}
  logoAlt="Kondept – konference dětské psychoterapie"
  homeHref="/kondept2/"
  cta={{ label: 'Vložit abstrakt', href: ABSTRACT_URL }}
>
  <EventHero
    edit="kondept"
    eyebrow="2. česká konference dětské psychoterapie"
    title="Metody – vztah – rodina – sebepéče"
    subtitle="Setkání, které posiluje komunitu dětských psychoterapeutů a čtyři pilíře naší profese."
    when="30. září – 2. října 2027"
    where="Kongres Hotel Jezerka, Seč"
    image={m.heroKondept}
    imageAlt="Děti foukají do odkvetlé pampelišky – vizuál konference"
  >
    <a class="btn" href="#aktivni-ucast">Aktivní účast <span class="arrow">→</span></a>
    <a class="btn ghost" href="#registrace">Registrace a ceny</a>
  </EventHero>

  <!-- O KONFERENCI -->
  <section class="section" id="o-konferenci">
    <div class="wrap split">
      <SectionHead title="O konferenci" />
      <div data-reveal style="--i:1">
        <p class="lede" data-edit="kondept.okonferenci.uvod" data-edit-label="O konferenci: úvodní odstavec">Milé kolegyně a milí kolegové, pole dětské psychoterapie se stává postupně v naší zemi lépe opečovaným a úrodnějším. Přibývá dětských psychoterapeutů, máme samostatný komplexní výcvik, řadu postgraduálních a specializačních výcviků i samostatnou sekci v rámci České asociace pro psychoterapii.</p>
        <p class="muted" data-edit="kondept.okonferenci.text" data-edit-label="O konferenci: druhý odstavec">Konference jsou skvělou příležitostí pro setkání, budování kontaktů a sítí vzájemné důvěry napříč zemí i organizacemi – a pro budování komunity, ve které bude každý dětský psychoterapeut moci cítit své místo, vzájemné vztahy a podporu. Protože to je i to, co potřebují naši dětští klienti.</p>
      </div>
    </div>
    <div class="wrap">
      <h3 class="pillars-title" data-reveal>Čtyři pilíře dětské psychoterapie</h3>
      <div class="pillars">
        {pillars.map(([k, t, d], i) => (
          <div class="pillar" data-reveal style={`--i:${i}`}>
            <span class="pk">{k}</span>
            <h4>{t}</h4>
            <p class="muted small">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PREZENTUJÍCÍ – odkaz na samostatnou stránku -->
  <section class="section tint" id="prezentujici">
    <div class="wrap split">
      <SectionHead eyebrow="Prezentující" title="Seznam prezentujících připravujeme" edit="kondept.prezentujici.nadpis" editLabel="Prezentující: nadpis" />
      <div data-reveal style="--i:1">
        <p class="muted" data-edit="kondept.prezentujici.text" data-edit-label="Prezentující: text">Jakmile odborná rada vybere příspěvky, zveřejníme prezentující i anotace na samostatné stránce. Chcete být mezi nimi? Přihlaste svůj příspěvek.</p>
        <div class="actions">
          <a class="btn" href="/kondept2/prezentujici/">Stránka prezentujících <span class="arrow">→</span></a>
          <a class="btn ghost" href="#aktivni-ucast">Aktivní účast</a>
        </div>
      </div>
    </div>
  </section>

  <!-- REGISTRACE -->
  <section class="section" id="registrace">
    <div class="wrap">
      <SectionHead eyebrow="Registrace a ubytování" title="Registrace" edit="kondept.registrace.nadpis" editLabel="Registrace: nadpis" />
      <div class="grid grid-2">
        <div data-reveal>
          <h3>Termíny registrace</h3>
          <ul class="dates" data-edit="kondept.registrace.terminy" data-edit-type="list" data-edit-label="Registrace: termíny">
            <li><b data-edit-field="datum" data-edit-label="Datum">15.–22. 5. 2027</b><span data-edit-field="popis" data-edit-label="Co se děje">předregistrace aktivních účastníků</span></li>
            <li><b data-edit-field="datum" data-edit-label="Datum">1. 6. – 31. 7. 2027</b><span data-edit-field="popis" data-edit-label="Co se děje">včasná registrace</span></li>
            <li><b data-edit-field="datum" data-edit-label="Datum">1.–31. 8. 2027</b><span data-edit-field="popis" data-edit-label="Co se děje">registrace</span></li>
          </ul>
          <h3 style="margin-top:clamp(2.5rem, 5vw, 3.5rem)">Ubytování</h3>
          <p class="muted" data-edit="kondept.registrace.ubytovani" data-edit-label="Registrace: ubytování">Ubytování v Kongres Hotelu Jezerka bude možné rezervovat při registraci.</p>
          <h3 style="margin-top:clamp(2.5rem, 5vw, 3.5rem)">Skupinové registrace</h3>
          <p class="muted" data-edit="kondept.registrace.skupinove" data-edit-label="Registrace: skupinové registrace">Chcete přihlásit více účastníků za jednu organizaci a zaplatit společně na jednu fakturu? Pro skupinovou registraci kontaktujte organizační agenturu na e-mailu <a href="mailto:info@kondept.cz">info@kondept.cz</a>.</p>
        </div>
        <div data-reveal style="--i:1">
          <h3>Registrační poplatek</h3>
          <table class="prices">
            <tbody data-edit="kondept.registrace.ceny" data-edit-type="list" data-edit-label="Registrace: ceník">
              <tr><td><span data-edit-field="polozka" data-edit-label="Položka">Včasná registrace</span><span class="muted price-note" data-edit-field="obdobi" data-edit-label="Upřesnění (nepovinné)">1. 6. – 31. 7. 2027</span></td><td data-edit-field="cena" data-edit-label="Cena">8 500 Kč</td></tr>
              <tr><td><span data-edit-field="polozka" data-edit-label="Položka">Registrace</span><span class="muted price-note" data-edit-field="obdobi" data-edit-label="Upřesnění (nepovinné)">1.–31. 8. 2027</span></td><td data-edit-field="cena" data-edit-label="Cena">9 500 Kč</td></tr>
              <tr><td><span data-edit-field="polozka" data-edit-label="Položka">Doprovodná osoba</span><span class="muted price-note" data-edit-field="obdobi" data-edit-label="Upřesnění (nepovinné)">vše kromě odborného programu</span></td><td data-edit-field="cena" data-edit-label="Cena">3 500 Kč</td></tr>
              <tr><td><span data-edit-field="polozka" data-edit-label="Položka">Sleva – aktivní účastník</span><span class="muted price-note" data-edit-field="obdobi" data-edit-label="Upřesnění (nepovinné)"></span></td><td data-edit-field="cena" data-edit-label="Cena">od 750 Kč</td></tr>
              <tr><td><span data-edit-field="polozka" data-edit-label="Položka">Sleva – student INDEPT</span><span class="muted price-note" data-edit-field="obdobi" data-edit-label="Upřesnění (nepovinné)"></span></td><td data-edit-field="cena" data-edit-label="Cena">1 000 Kč</td></tr>
            </tbody>
          </table>
          <p class="small muted">Ceny jsou včetně DPH 21 %.</p>
        </div>
      </div>
      <div class="grid grid-3 more-info">
        <div class="card" data-reveal>
          <h3>Poplatek zahrnuje</h3>
          <ul data-edit="kondept.registrace.zahrnuje" data-edit-type="list" data-edit-label="Registrace: co poplatek zahrnuje">
            <li><span data-edit-field="polozka" data-edit-label="Co je v ceně">odborný program – 3 dny, přibližně 21 vzdělávacích hodin</span></li>
            <li><span data-edit-field="polozka" data-edit-label="Co je v ceně">doprovodný program včetně dvou večerních programů</span></li>
            <li><span data-edit-field="polozka" data-edit-label="Co je v ceně">4 kávové přestávky</span></li>
            <li><span data-edit-field="polozka" data-edit-label="Co je v ceně">oběd a večeři ve čtvrtek, oběd a večerní raut v pátek</span></li>
            <li><span data-edit-field="polozka" data-edit-label="Co je v ceně">kredity pro vzdělávání</span></li>
            <li><span data-edit-field="polozka" data-edit-label="Co je v ceně">audiovizuální nahrávku přednášek z hlavního sálu</span></li>
          </ul>
        </div>
        <div class="card" data-reveal style="--i:1">
          <h3>Storno poplatky</h3>
          <ul data-edit="kondept.registrace.storno" data-edit-type="list" data-edit-label="Registrace: storno poplatky">
            <li><span data-edit-field="polozka" data-edit-label="Podmínka">storno do 31. května 2027 = bez poplatku</span></li>
            <li><span data-edit-field="polozka" data-edit-label="Podmínka">storno od 1. června 2027 = 100 % z uhrazené částky nebo nalezení náhradníka</span></li>
          </ul>
        </div>
        <div class="card" data-reveal style="--i:2">
          <h3>Zahraniční platba</h3>
          <p class="small" data-edit="kondept.registrace.zahranici.uvod" data-edit-label="Zahraniční platba: úvod">Žádáme dodržení následujících pokynů, aby byla platba připsána na náš účet v plné výši registračního poplatku:</p>
          <ul data-edit="kondept.registrace.zahranici" data-edit-type="list" data-edit-label="Zahraniční platba: pokyny">
            <li><span data-edit-field="polozka" data-edit-label="Pokyn">Zahraniční platební příkaz zadejte v měně CZK (české koruny).</span></li>
            <li><span data-edit-field="polozka" data-edit-label="Pokyn">U bankovních poplatků zvolte variantu OUR (veškeré poplatky hradí plátce).</span></li>
            <li><span data-edit-field="polozka" data-edit-label="Pokyn">Pokud variantu OUR vaše banka nenabízí, platbu navyšte o bankovní poplatky ve výši 150 Kč.</span></li>
            <li><span data-edit-field="polozka" data-edit-label="Pokyn">Případný rozdíl mezi uhrazenou a požadovanou částkou bude nutné doplatit při registraci na konferenci.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- AKTIVNÍ ÚČAST -->
  <section class="section tint" id="aktivni-ucast">
    <div class="wrap split">
      <SectionHead eyebrow="Aktivní účast" title="Máte co říct k tématu konference?" edit="kondept.aktivni.nadpis" editLabel="Aktivní účast: nadpis">
        <div class="actions">
          <a class="btn" href={ABSTRACT_URL} target="_blank" rel="noopener">Vložit abstrakt ↗</a>
        </div>
      </SectionHead>
      <div data-reveal style="--i:1">
        <div data-edit="kondept.aktivni.text" data-edit-label="Aktivní účast: text">
          <p class="lede">Zveme vás k aktivní účasti na 2. české konferenci dětské psychoterapie</p>
          <p>Cílem konference je i nadále propojovat a posilovat čtyři základní pilíře dětské psychoterapie: METODY – VZTAH – RODINA – SEBEPÉČE</p>
          <p>Program konference bude tvořen odbornými přednáškami, workshopy a diskuzemi, které tyto pilíře rozvíjejí.</p>
          <p>Stejně jako v minulém ročníku zůstává otevřený prostor pro aktivní účast — bez pevné definice, aby mohl organicky vyrůst z toho, co přinesete vy sami. Je určen každému, kdo chce představit inspirativní zkušenost, téma, kazuistiku, výzkum či vlastní projekt z oblasti dětské psychoterapie.</p>

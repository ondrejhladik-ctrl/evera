<script>
  const dlg = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.photos .ph')];
  if (dlg && thumbs.length) {
    const big = dlg.querySelector('img')!;
    const count = dlg.querySelector<HTMLElement>('.lb-count')!;
    let cur = 0;
    const show = (i: number) => {
      cur = (i + thumbs.length) % thumbs.length;
      big.src = thumbs[cur].querySelector('img')!.currentSrc || thumbs[cur].querySelector('img')!.src;
      count.textContent = `${cur + 1} / ${thumbs.length}`;
    };
    thumbs.forEach((t, i) => t.addEventListener('click', () => { show(i); dlg.showModal(); }));
    dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(cur - 1));
    dlg.querySelector('.lb-next')!.addEventListener('click', () => show(cur + 1));
    // klik mimo fotku zavře
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => thumbs[cur]?.focus());
    document.addEventListener('keydown', (e) => {
      if (!dlg.open) return;
      if (e.key === 'ArrowLeft') show(cur - 1);
      if (e.key === 'ArrowRight') show(cur + 1);
    });
    // swipe na mobilu
    let x0: number | null = null;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0; x0 = null;
      if (Math.abs(dx) > 40) show(cur + (dx < 0 ? 1 : -1));
    });
  }
</script>


---
import Base from '../../layouts/Base.astro';
import m from '../../data/media.json';
import { NAV, ABSTRACT_URL } from '../../data/kondept';
---
<Base
  title="Prezentující | 2. česká konference dětské psychoterapie 2027"
  description="Prezentující 2. české konference dětské psychoterapie – seznam připravujeme."
  theme="kondept"
  nav={NAV}
  logo={m.logoKondept}
  logoAlt="Kondept – konference dětské psychoterapie"
  homeHref="/kondept2/"
  cta={{ label: 'Vložit abstrakt', href: ABSTRACT_URL }}
>
  <section class="section soon">
    <div class="wrap narrow hero-in">
      <a class="back small" href="/kondept2/">← 2. česká konference dětské psychoterapie</a>
      <h1>Seznam prezentujících pro vás připravujeme</h1>
      <p class="lede">Příjem abstraktů běží do 15. ledna 2027. V březnu 2027 oznámíme výsledky výběru a zveřejníme zde prezentující i anotace jejich příspěvků.</p>
      <div class="actions">
        <a class="btn" href={ABSTRACT_URL} target="_blank" rel="noopener">Vložit abstrakt ↗</a>
        <a class="btn ghost" href="/kondept2/#aktivni-ucast">Jak se zapojit</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .soon { min-height: 60vh; display: flex; align-items: center; }
  .back { display: inline-block; margin-bottom: 1.5rem; text-decoration: none; color: var(--ink-soft); }
</style>

---
import Base from '../layouts/Base.astro';
---
<Base title="Poptávka odeslána – Evera" description="Děkujeme za poptávku.">
  <section class="section sent">
    <div class="wrap narrow hero-in">
      <h1>Děkujeme, poptávka je odeslaná</h1>
      <p class="lede">Ozveme se vám co nejdříve. Pokud spěcháte, zavolejte nám na <a href="tel:+420731573668">+420 731 573 668</a>.</p>
      <div class="actions"><a class="btn" href="/">Zpět na hlavní stránku</a></div>
    </div>
  </section>
</Base>
<style>
  .sent { min-height: 65vh; display: flex; align-items: center; }
  .sent h1 { font-size: var(--fs-2xl); }
</style>

---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import Bubbles from '../../components/Bubbles.astro';
import '../../styles/setkani.css';
import m from '../../data/media.json';
import lide from '../../data/setkani-lide.json';
import { NAV, KEYNOTES, REG_URL, EMAIL } from '../../data/setkani';

const BANNER = '/media/2026/11/banner-setkani-2300.webp';
const BANNER_S = '/media/2026/11/banner-setkani-1200.webp';

// fotky z Gestalt lásky 2024, které se pod úvodním textem střídají
const slides = ['DSC_1100', 'DSC_0537-2', 'DSC_0240', 'DSC_0570-2', 'DSC_0503-2', 'DSC_0366'].map((n) => `/media/2023/06/${n}-1600.webp`);

const topics = [
  ['Pohyb teorie a výzkumu', 'Vývoj konceptů a nové směry v psychoterapeutickém výzkumu'],
  ['Živá praxe', 'Sdílení impulzů, inspirací a výzev z každodenní terapeutické praxe'],
  ['Mezioborový tanec', 'propojování gestalt terapie s jinými směry a oblastmi'],
  ['Kreativita a tělo', 'rozvíjení kontaktu skrze tělo, hru a umělecké vyjádření'],
];
const hotels = [
  { name: 'Hotel Dvořák', url: 'https://www.lhdvoraktabor.cz', contact: 'Rezervace písemně: recepce@lhdvoraktabor.cz; ověření volné kapacity: +420 381 212 221, +420 601 165 855. Rezervaci je nutné garantovat úhradou 100% zálohy se splatností do 26. 2. 2027.', price: 'sgl / dbl single use 2 800 Kč · dbl 3 000 Kč · quad, apt 4 pax 5 800 Kč · přistýlka 1 200 Kč' },
  { name: 'Eleonora Romantik Hotel', url: 'https://www.eleonorahotel.cz', contact: 'eleonorahotel.recepce@gmail.com, +420 720 536 570', price: 'dbl single use 2 190 Kč · dbl 3 290 Kč · apt 4 pax 5 490 Kč · přistýlka 980 Kč' },
  { name: 'Boutique Hotel Nautilus', url: 'https://www.hotelnautilus.cz/en/', contact: 'info@hotelnautilus.cz, +420 380 900 900, +420 602 697 758', price: 'sgl 3 550 Kč · dbl 3 750 Kč · přistýlka 700 Kč' },
  { name: 'Apartmány Pension Hradební', url: 'https://penzionhradebnitabor.cz/cs/', contact: 'penzion.hradebni@gmail.com, +420 732 208 280', price: '' },
];
const BOOKING = 'https://www.booking.com/searchresults.cs.html?ss=Tábor&ssne=Tábor&ssne_untouched=Tábor&efdco=1&label=tabor-mOTIY78NmHa4qQ_dWpgCugS379606577034%3Apl%3Ata%3Ap1%3Ap2%3Aac%3Aap%3Aneg%3Afi%3Atikwd-414411242340%3Alp1003803%3Ali%3Adec%3Adm%3Appccp%3DUmFuZG9tSVYkc2RlIyh9YfqnDqqG8nt1QPdfOnScMCA&aid=1610700&lang=cs&sb=1&src_elem=sb&src=city&dest_id=-556514&dest_type=city&checkin=2027-05-06&checkout=2027-05-09&group_adults=2&no_rooms=1&group_children=0&sb_travel_purpose=leisure&sb_lp=1';
const AIRBNB = 'https://www.airbnb.cz/s/tábor--česko/homes?refinement_paths%5B%5D=%2Fhomes&location=tábor%2C+česko&checkin=2027-05-06&checkout=2027-05-09&date_picker_type=calendar&adults=2&children=0';

// akreditace – plné znění ze starého webu (použito v Programu i v Častých otázkách)
const akreditace = `<p>Organizátoři požádali o akreditaci vzdělávací akce u AKP ČR a ČLK JEP.</p>
<p>Celkový rozsah odborného programu je 23 vzdělávacích hodin.</p>
<h4>Česká lékařská komora (ČLK JEP)</h4>
<p>Odborný garant: MUDr. Martin Černý, Ph.D.</p>
<p>Vzdělávací akce je pořádána v souladu se Stavovským předpisem ČLK č. 16 a je ohodnocena 24 kredity za pasivní účast. Kredity za aktivní účast budou přednášejícím připsány zpětně po skončení akce, v souladu s příslušnými předpisy.</p>
<h4>Asociace klinických psychologů ČR (AKP ČR)</h4>
<p>Odborná garantka: PhDr. Alena Špirková</p>
<p>Vzdělávací akce je zařazena do systému celoživotního vzdělávání klinických psychologů a je ohodnocena 12 kredity za pasivní účast.</p>
<p>Za aktivní účast se připočítávají další kredity podle počtu autorů příspěvku:</p>
<ul class="bullets"><li>10 kreditů při jednom autorovi,</li><li>5 kreditů při spoluautorství.</li></ul>`;

const faq = [
  ['Kdy se konference koná?', '<p>6.–9. května 2027 (čtvrtek až neděle)</p>'],
  ['Kde se konference koná?', '<p>Hlavním místem konání konference je <strong>Hotel Palcát</strong>, konferenční hotel v blízkosti historického centra. Nabízí kvalitní konferenční zázemí, komfortní ubytování i kompletní gastronomické služby.</p><p>Další konferenční prostory poskytují <strong>Spolkový dům Střelnice</strong>, <strong>Divadlo Oskara Nedbala Tábor</strong> a <strong>komunitní prostor Truhlárna</strong>, které se nacházejí pouhých 5 minut chůze od hotelu. Díky jejich blízkosti lze všechny prostory pohodlně využít pro paralelní program konference.</p><p>Spojení moderního konferenčního zázemí, historického prostředí Tábora a výborné dostupnosti všech míst vytváří ideální podmínky pro pořádání konference.</p>'],
  ['Kdy konference začíná a končí?', '<p>Zahájení konference úvodním slovem organizátorů je ve čtvrtek 6. května 2027 ve 13:30.</p><p>Konference končí závěrečným slovem organizátorů v neděli 9. května 2027 ve 13:00.</p>'],
  ['Jaká jsou důležitá data konference?', '<ul class="bullets"><li>20. března 2026 – otevření příjmu abstraktů</li><li>31. května 2026 – uzávěrka příjmu abstraktů</li><li>září 2026 – oznámení aktivním účastníkům o přijetí/nepřijetí abstraktů</li><li>1.–8. listopadu 2026 – předregistrace aktivní účastníci</li><li>22.–29. listopadu 2026 – předregistrace členové ČSGT</li><li>30. listopadu 2026 – spuštění včasné registrace</li><li>31. ledna 2027 – ukončení včasné registrace</li><li>15. března 2027 – spuštění přihlašování na přednášky a workshopy v aplikaci Eventee</li><li>15. března 2027 – ukončení registrace</li></ul>'],
  ['Jaké jsou storno podmínky?', '<ul class="bullets"><li>storno do 31. ledna 2027 = bez poplatku</li><li>storno od 1. února 2027 = 100 % z uhrazené částky nebo nalezení náhradníka</li></ul>'],
  ['Je konference akreditovaná?', akreditace],
];
const partners = [
  { img: m.pPad, url: 'https://www.pad.cz', name: 'PAD – Psychopad a VRPAD' },
  { img: m.pPortal, url: 'https://nakladatelstvi.portal.cz/nakladatelstvi', name: 'Portál' },
  { img: m.pBcreative, url: 'https://www.b-creative.cz/', name: 'b-creative' },
  { img: m.pGrada, url: 'https://www.grada.cz/', name: 'Grada' },
  { img: m.pPsychologie, url: 'https://psychologie.cz/', name: 'Psychologie.cz' },
  { img: m.pNevypust, url: 'https://nevypustdusi.cz', name: 'Nevypusť duši' },
  { img: m.pMydlarna, url: 'https://www.mydlarnaudvoukocek.cz/', name: 'Mýdlárna U dvou koček' },
  { img: m.pSchwabe, url: 'https://www.schwabe.cz/', name: 'Schwabe' },
  { img: m.pNaturevia, url: 'https://www.naturevia.cz/', name: 'Naturevia' },
];
const institutes = [
  { img: m.oDialog, url: 'https://gestalt-dialog.cz', name: 'Dialog' },
  { img: m.oGP, url: 'https://www.gestalt-praha.cz', name: 'Gestalt Praha' },
  { img: m.oGS, url: 'https://gestaltstudia.cz', name: 'Gestalt Studia' },
  { img: m.oInstep, url: 'https://instep.cz', name: 'Instep' },
];
const teamImg: Record<string, string> = {
  'Mgr. Peter Kollár': m.tKollar,
  'PhDr. Michal Černík, Ph.D.': m.tCernik,
  'Mgr. Markéta Chlupová': m.tChlupova,
  'PhDr. Alena Špirková': m.tSpirkova,
  'Mgr. Ondřej Pečený': m.tPeceny,
};
const V = (n: string) => `/media/2026/11/vybor/${n}.webp`;
const vyborImg: Record<string, string> = {
  'MUDr. Genovéva Almássy': V('almassy'),
  'Mgr. Vratislav Bareš': V('bares'),
  'PhDr. Michal Černík, Ph.D.': V('cernik'),
  'Mgr. Kristýna Anna Černíková, Ph.D.': V('cernikova'),
  'MUDr. Martin Černý, Ph.D.': V('cerny'),
  'PhDr. Martin Jára': V('jara'),
  'Mgr. Peter Kollár': V('kollar'),
  'MUDr. Elena Křivková': V('krivkova'),
  'PhDr. Tomáš Komárek': V('komarek'),
  'Mgr. Ondřej Novák': V('novak'),
  'Mgr. Michal Pernička, Ph.D.': V('pernicka'),
  'MUDr. Juraj Rektor': V('rektor'),
  'doc. MUDr. Jan Roubal, Ph.D.': V('roubal'),
  'Mgr. Nina Schautová Ph.D.': V('schautova'),
  'Mgr. Sylvie Tichotová, Ph.D.': V('tichotova'),
};
const slug = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<Base
  title="Gestalt Tábor – Setkání v pohybu | 8. konference gestalt psychoterapie 2027"
  description="8. konference gestalt psychoterapie GESTALT TÁBOR „Setkání v pohybu“, 6.–9. května 2027, Tábor."
  theme="setkani"
  onestoPage="Setkání v pohybu"
  nav={NAV}
  logo={m.logoSetkani}
  logoAlt="Gestalt Tábor – Setkání v pohybu"
  homeHref="/setkani-v-pohybu/"
  cta={{ label: 'Registrace', href: '/setkani-v-pohybu/#registrace' }}
  contactEmail={EMAIL}
>
  <!-- ÚVOD: banner a pod ním název, na střed -->
  <section class="shero">
    <div class="wrap wide banner">
      <img src={BANNER} srcset={`${BANNER_S} 1200w, ${BANNER} 2300w`} sizes="(min-width: 1150px) 68rem, 100vw" alt="Tábor s barevnými bublinami – vizuál konference Gestalt Tábor: Setkání v pohybu, 6.–9. 5. 2027" width="2300" height="630" fetchpriority="high" />
    </div>
    <div class="wrap shero-text hero-in">
      <p class="kicker" data-edit="setkani.uvod.nadtitulek" data-edit-label="Úvod: text nad nadpisem">8. konference gestalt psychoterapie</p>
      <h1 data-edit="setkani.uvod.nadpis2" data-edit-label="Úvod: hlavní nadpis">GESTALT TÁBOR<span>Setkání v pohybu</span></h1>
      <p class="when" data-edit="setkani.uvod.termin" data-edit-label="Úvod: místo a termín">Tábor 6.–9. května 2027</p>
    </div>
  </section>

  <!-- O KONFERENCI – původní text beze změn -->
  <section class="section" id="o-konferenci">
    <Bubbles set={1} />
    <div class="wrap">
      <SectionHead title="O konferenci" />
      <div class="prose" data-reveal data-edit="setkani.okonferenci.text2" data-edit-type="rich" data-edit-label="O konferenci: text">
        <p>Současný svět nás staví před situace, které nelze ignorovat. Zrychlené tempo, polarizace společnosti i environmentální výzvy vstupují do našich životů a terapeutických pracoven. Jako gestalt terapeuti vnímáme, že z nehybnosti se rodí nový pohyb, ale stejně tak věříme v sílu vědomého zastavení a ticha.</p>
        <p><strong>Konference GESTALT TÁBOR „Setkání v pohybu“</strong> nabídne prostor pro setkání a dialog, pro pohyb směrem k sobě i druhým, ale také chvíle ticha a klidu.</p>
        <p><strong>Tematické okruhy konference:</strong></p>
        <ul class="bullets">
          {topics.map(([t, d]) => <li><strong>{t}:</strong> {d}</li>)}
        </ul>
        <p>Zveme vás k prozkoumání pohybu směrem k sobě, k druhým i celku, jehož jsme součástí.</p>
        <p><strong>Rádi budeme pokračovat ve směru, který naše gestalt komunita nabrala na poslední konferenci Gestalt lásky 2024 v Seči.</strong></p>
      </div>
      <div class="slides" data-reveal aria-label="Fotografie z konference Gestalt lásky 2024">
        {slides.map((src, i) => <img src={src} alt="Konference Gestalt lásky 2024 v Seči" loading={i ? 'lazy' : 'eager'} width="1600" height="1067" style={`--n:${i}`} />)}
      </div>
    </div>
  </section>

  <!-- PREZENTUJÍCÍ – upoutávka, seznam je na samostatné stránce -->
  <section class="section tint" id="prezentujici">
    <Bubbles set={2} />
    <div class="wrap">
      <SectionHead title="Hlavní hosté konference">
        <p data-edit="setkani.prezentujici.uvod" data-edit-label="Hlavní hosté: věta pod nadpisem">V roce 2027 přivítá naše konference výrazné osobnosti současné gestalt terapie z Česka, Evropy i zámoří.</p>
      </SectionHead>
      <ul class="keynotes">
        {KEYNOTES.map((k, i) => (
          <li data-reveal style={`--i:${i}`}>
            <a href={`/setkani-v-pohybu/prezentujici/#${slug(k.name)}`}>
              <img src={k.img} alt={k.name} loading="lazy" width="200" height="200" />
              <span class="kn">{k.name}</span>
              <span class="kc">{k.country}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="actions" data-reveal>
        <a class="btn" href="/setkani-v-pohybu/prezentujici/">Všichni prezentující <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- REGISTRACE -->
  <section class="section" id="registrace">
    <Bubbles set={3} />
    <div class="wrap">
      <SectionHead title="Registrace" edit="setkani.registrace.nadpis" editLabel="Registrace: nadpis">
        <p data-edit="setkani.registrace.oznameni" data-edit-label="Registrace: krátké oznámení pod nadpisem">Tlačítko registrace pro členy ČSGT aktivujeme 22. listopadu ve 12:00.</p>
        <div class="actions">
          <a class="btn" href={REG_URL} target="_blank" rel="noopener">Registrace ↗</a>
        </div>
      </SectionHead>

      <div class="blocks">
        <div data-reveal>
          <h3>Termíny registrace</h3>
          <ul class="dates" data-edit="setkani.registrace.terminy2" data-edit-type="list" data-edit-label="Registrace: termíny">
            <li><b data-edit-field="datum" data-edit-label="Datum">1.–8. 11. 2026</b><span data-edit-field="popis" data-edit-label="Co se děje">předregistrace aktivní účastníci</span></li>
            <li><b data-edit-field="datum" data-edit-label="Datum">22.–29. 11. 2026</b><span data-edit-field="popis" data-edit-label="Co se děje">předregistrace členové ČSGT (22. 11. 12:00 – 29. 11. 12:00)</span></li>
            <li><b data-edit-field="datum" data-edit-label="Datum">30. 11. 2026 – 31. 1. 2027</b><span data-edit-field="popis" data-edit-label="Co se děje">včasná registrace (30. 11. 12:00 – 31. 1. 12:00)</span></li>
            <li><b data-edit-field="datum" data-edit-label="Datum">1. 2. – 15. 3. 2027</b><span data-edit-field="popis" data-edit-label="Co se děje">registrace</span></li>
          </ul>
        </div>

        <div data-reveal>
          <h3>Výše registračního poplatku včetně DPH 21 %</h3>
          <table class="prices">
            <tbody data-edit="setkani.registrace.ceny" data-edit-type="list" data-edit-label="Registrace: ceník">
              <tr><td><span data-edit-field="polozka" data-edit-label="Položka">Včasná registrace</span><span class="muted price-note" data-edit-field="obdobi" data-edit-label="Upřesnění (nepovinné)">30. 11. 2026 – 31. 1. 2027</span></td><td data-edit-field="cena" data-edit-label="Cena">9 200 Kč</td></tr>
              <tr><td><span data-edit-field="polozka" data-edit-label="Položka">Registrace</span><span class="muted price-note" data-edit-field="obdobi" data-edit-label="Upřesnění (nepovinné)">1. 2. – 15. 3. 2027</span></td><td data-edit-field="cena" data-edit-label="Cena">10 200 Kč</td></tr>
              <tr><td><span data-edit-field="polozka" data-edit-label="Položka">Doprovodná osoba</span><span class="muted price-note" data-edit-field="obdobi" data-edit-label="Upřesnění (nepovinné)">zahrnuje vše kromě odborného programu</span></td><td data-edit-field="cena" data-edit-label="Cena">3 600 Kč</td></tr>
              <tr><td><span data-edit-field="polozka" data-edit-label="Položka">Sleva – aktivní účastník</span><span class="muted price-note" data-edit-field="obdobi" data-edit-label="Upřesnění (nepovinné)">předregistrace 1.–8. 11. 2026</span></td><td data-edit-field="cena" data-edit-label="Cena">od 500 Kč</td></tr>
              <tr><td><span data-edit-field="polozka" data-edit-label="Položka">Sleva – člen ČSGT</span><span class="muted price-note" data-edit-field="obdobi" data-edit-label="Upřesnění (nepovinné)">předregistrace 22.–29. 11. 2026</span></td><td data-edit-field="cena" data-edit-label="Cena">500 Kč</td></tr>
            </tbody>
          </table>
        </div>

        <div data-reveal>
          <h3>Skupinové registrace</h3>
          <p>Pro skupinové registrace kontaktujte organizační agenturu na e-mailové adrese <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p>
        </div>

        <div data-reveal>
          <h3>Kalkulace slevy pro aktivní účastníky</h3>
          <p>Jeden prezentující má slevu 1 000 Kč za každý svůj samostatný příspěvek. Pokud má příspěvek dva a více prezentujících, má každý z nich slevu 500 Kč. Slevy za jednotlivé příspěvky se u jednoho prezentujícího sčítají.</p>
          <p>Příklad: Na konferenci budu mít jednu samostatnou přednášku (sleva 1 000 Kč) a jeden workshop vedený společně s kolegou (sleva 500 Kč). Celková sleva na registračním poplatku tedy činí 1 500 Kč.</p>
          <p>Jste-li aktivní účastník i člen ČSGT, započítávají se vám obě slevy.</p>
        </div>

        <div data-reveal>
          <h3>Registrační poplatek zahrnuje</h3>
          <ul class="bullets">
            <li>odborný program konference – 4 konferenční dny v rozsahu přibližně 30 vzdělávacích hodin</li>
            <li>doprovodný program v průběhu celé konference včetně tří večerních programů</li>
            <li>6 kávových přestávek</li>
            <li>večeři ve čtvrtek</li>
            <li>oběd a večeři v pátek</li>
            <li>oběd a bohatý večerní raut v sobotu</li>
            <li>kredity pro vzdělávání</li>
            <li>audiovizuální nahrávku přednášek z hlavního sálu</li>
          </ul>
        </div>

        <div data-reveal>
          <h3>Storno poplatky</h3>
          <ul class="bullets">
            <li>storno do 31. ledna 2027 = bez poplatku</li>
            <li>storno od 1. února 2027 = 100 % z uhrazené částky nebo nalezení náhradníka</li>
          </ul>
        </div>

        <div data-reveal>
          <h3>Zahraniční platba</h3>
          <p>Žádáme o dodržení následujících pokynů, aby byla platba připsána na náš účet v plné výši registračního poplatku:</p>
          <ul class="bullets">
            <li>Zahraniční platební příkaz zadejte v měně CZK (české koruny).</li>
            <li>U bankovních poplatků zvolte variantu OUR (veškeré poplatky hradí plátce).</li>
            <li>Pokud variantu OUR vaše banka nenabízí, platbu navyšte o bankovní poplatky ve výši 150 Kč.</li>
            <li>Případný rozdíl mezi uhrazenou a požadovanou částkou bude nutné doplatit při registraci na konferenci.</li>
          </ul>
        </div>

        <div data-reveal>
          <h3>Ubytování v Táboře</h3>
          <p>Pro účastníky jsme předběžně rezervovali kapacity v následujících hotelech (do 31. 1. 2027). Rezervaci si zajišťujete sami přímo v hotelu s heslem <strong>„Setkání v pohybu“</strong>. Ceny jsou za noc včetně snídaně; poplatek z ubytování 21 Kč/os./noc není zahrnut.</p>
          {hotels.map((h) => (
            <details class="fold">
              <summary>{h.name}</summary>
              <div class="fold-body">
                <p>{h.contact}</p>
                {h.price && <p class="muted">{h.price}</p>}
                <p><a href={h.url} target="_blank" rel="noopener">Web hotelu ↗</a></p>
              </div>
            </details>
          ))}
          <p class="more-stay">Další možnosti: <a href="https://www.visittabor.eu/ubytovani" target="_blank" rel="noopener">visittabor.eu</a>, <a href={BOOKING} target="_blank" rel="noopener">Booking</a>, <a href={AIRBNB} target="_blank" rel="noopener">Airbnb</a> (bez předem rezervované kapacity). Hotel Tábor ukončil činnost, ubytování v něm již není možné.</p>

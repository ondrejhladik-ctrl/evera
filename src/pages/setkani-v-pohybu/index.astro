---
import Base from '../../layouts/Base.astro';
import EventHero from '../../components/EventHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import m from '../../data/media.json';
import lide from '../../data/setkani-lide.json';
import { NAV, KEYNOTES } from '../../data/setkani';

const topics = [
  ['Pohyb teorie a výzkumu', 'Vývoj konceptů a nové směry v psychoterapeutickém výzkumu.'],
  ['Živá praxe', 'Sdílení impulzů, inspirací a výzev z každodenní terapeutické praxe.'],
  ['Mezioborový tanec', 'Propojování gestalt terapie s jinými směry a oblastmi.'],
  ['Kreativita a tělo', 'Rozvíjení kontaktu skrze tělo, hru a umělecké vyjádření.'],
];
const hotels = [
  { name: 'Hotel Dvořák', url: 'https://www.lhdvoraktabor.cz', contact: 'Rezervace písemně: recepce@lhdvoraktabor.cz; ověření volné kapacity: +420 381 212 221, +420 601 165 855. Rezervaci je nutné garantovat úhradou 100% zálohy se splatností do 26. 2. 2027.', price: 'sgl / dbl single use 2 800 Kč · dbl 3 000 Kč · quad, apt 4 pax 5 800 Kč · přistýlka 1 200 Kč' },
  { name: 'Eleonora Romantik Hotel', url: 'https://www.eleonorahotel.cz', contact: 'eleonorahotel.recepce@gmail.com, +420 720 536 570', price: 'dbl single use 2 190 Kč · dbl 3 290 Kč · apt 4 pax 5 490 Kč · přistýlka 980 Kč' },
  { name: 'Boutique Hotel Nautilus', url: 'https://www.hotelnautilus.cz/en/', contact: 'info@hotelnautilus.cz, +420 380 900 900, +420 602 697 758', price: 'sgl 3 550 Kč · dbl 3 750 Kč · přistýlka 700 Kč' },
  { name: 'Apartmány Pension Hradební', url: 'https://penzionhradebnitabor.cz/cs/', contact: 'penzion.hradebni@gmail.com, +420 732 208 280', price: '' },
];
const faq = [
  ['Kdy se konference koná?', '<p>6.–9. května 2027 (čtvrtek až neděle).</p>'],
  ['Kde se konference koná?', '<p>Hlavním místem konání je <strong>Hotel Palcát</strong>, konferenční hotel v blízkosti historického centra Tábora. Další konferenční prostory poskytují <strong>Spolkový dům Střelnice</strong>, <strong>Divadlo Oskara Nedbala Tábor</strong> a <strong>komunitní prostor Truhlárna</strong> – všechny jen 5 minut chůze od hotelu, takže je lze pohodlně využít pro paralelní program.</p>'],
  ['Kdy konference začíná a končí?', '<p>Zahájení úvodním slovem organizátorů je ve čtvrtek 6. května 2027 ve 13:30. Konference končí závěrečným slovem v neděli 9. května 2027 ve 13:00.</p>'],
  ['Jaké jsou storno podmínky?', '<p>Storno do 31. ledna 2027 bez poplatku. Od 1. února 2027 účtujeme 100 % uhrazené částky, případně můžete najít náhradníka.</p>'],
  ['Jak se přihlásím na jednotlivé přednášky a workshopy?', '<p>Přihlašování na přednášky a workshopy bude spuštěno 15. března 2027 v aplikaci Eventee.</p>'],
  ['Je konference akreditovaná?', '<p>Organizátoři požádali o akreditaci u AKP ČR a ČLK JEP. Podrobnosti najdete v části <a href="#program">Program a akreditace</a>.</p>'],
];
const partners = [
  { img: m.pPad, url: 'https://www.pad.cz', name: 'PAD – Psychopad a VRPAD' },
  { img: m.pPortal, url: 'https://nakladatelstvi.portal.cz/nakladatelstvi', name: 'Portál' },
  { img: m.pBcreative, url: 'https://www.b-creative.cz/', name: 'b-creative' },
  { img: m.pGrada, url: 'https://www.grada.cz/', name: 'Grada' },
  { img: m.pPsychologie, url: 'https://psychologie.cz/', name: 'Psychologie.cz' },
  { img: m.pNevypust, url: 'https://nevypustdusi.cz', name: 'Nevypusť duši' },
  { img: m.pAlchymista, url: 'https://www.alchymista.online/', name: 'Alchymista' },
  { img: m.pMydlarna, url: 'https://www.mydlarnaudvoukocek.cz/', name: 'Mýdlárna U dvou koček' },
  { img: m.pSchwabe, url: 'https://www.schwabe.cz/', name: 'Schwabe' },
  { img: m.pNaturevia, url: 'https://www.naturevia.cz/', name: 'Naturevia' },
];
const institutes = [
  { img: m.oDialog, url: 'https://gestalt-dialog.cz', name: 'Dialog' },
  { img: m.oGP, url: 'https://www.gestalt-praha.cz', name: 'Gestalt Praha' },
  { img: m.oGS, url: 'https://gestaltstudia.cz', name: 'Gestalt Studia' },
  { img: m.oInstep, url: 'https://instep.cz', name: 'Instep' },
];
const teamImg: Record<string, string> = {
  'Mgr. Peter Kollár': m.tKollar,
  'PhDr. Michal Černík, Ph.D.': m.tCernik,
  'Mgr. Markéta Chlupová': m.tChlupova,
  'PhDr. Alena Špirková': m.tSpirkova,
  'Mgr. Ondřej Pečený': m.tPeceny,
};
---
<Base
  title="Gestalt Tábor – Setkání v pohybu | 8. konference gestalt psychoterapie 2027"
  description="8. konference gestalt psychoterapie GESTALT TÁBOR „Setkání v pohybu“, 6.–9. května 2027, Tábor."
  theme="setkani"
  nav={NAV}
  logo={m.logoSetkani}
  logoAlt="Gestalt Tábor – Setkání v pohybu"
  homeHref="/setkani-v-pohybu/"
  cta={{ label: 'Registrace', href: '/setkani-v-pohybu/#registrace' }}
>
  <EventHero
    eyebrow="8. konference gestalt psychoterapie"
    title="Gestalt Tábor: Setkání v pohybu"
    subtitle="Prostor pro setkání a dialog, pro pohyb směrem k sobě i druhým – ale také chvíle ticha a klidu."
    when="6.–9. května 2027"
    where="Tábor, Hotel Palcát a okolí"
    image={m.heroSetkani}
    imageAlt="Tábor s barevnými kruhy – vizuál konference Setkání v pohybu"
  >
    <a class="btn" href="#registrace">Registrace a ceny <span class="arrow">→</span></a>
    <a class="btn ghost" href="/setkani-v-pohybu/prezentujici/">Prezentující a program</a>
  </EventHero>

  <!-- O KONFERENCI -->
  <section class="section" id="o-konferenci">
    <div class="wrap split">
      <SectionHead eyebrow="O konferenci" title="Z nehybnosti se rodí nový pohyb" />
      <div data-reveal style="--i:1">
        <p class="lede">Současný svět nás staví před situace, které nelze ignorovat. Zrychlené tempo, polarizace společnosti i environmentální výzvy vstupují do našich životů a terapeutických pracoven.</p>
        <p class="muted">Jako gestalt terapeuti vnímáme, že z nehybnosti se rodí nový pohyb, ale stejně tak věříme v sílu vědomého zastavení a ticha. Zveme vás k prozkoumání pohybu směrem k sobě, k druhým i k celku, jehož jsme součástí. Rádi budeme pokračovat ve směru, který naše gestalt komunita nabrala na poslední konferenci Gestalt lásky 2024 v Seči.</p>
      </div>
    </div>
    <div class="wrap">
      <h3 class="topics-title" data-reveal>Tematické okruhy</h3>
      <div class="topics">
        {topics.map(([t, d], i) => (
          <div class="topic" data-reveal style={`--i:${i}`}>
            <span class="dot" aria-hidden="true"></span>
            <h4>{t}</h4>
            <p class="muted">{d}</p>
          </div>
        ))}
      </div>
      <div class="photos" data-reveal>
        <img src={m.sp1} alt="Konference Gestalt lásky 2024" loading="lazy" />
        <img src={m.sp2} alt="Konference Gestalt lásky 2024" loading="lazy" />
        <img src={m.sp3} alt="Konference Gestalt lásky 2024" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- PREZENTUJÍCÍ – jen upoutávka, seznam je na samostatné stránce -->
  <section class="section tint" id="prezentujici">
    <div class="wrap">
      <SectionHead eyebrow="Prezentující" title="Hlavní hosté konference">
        <p class="muted">Výrazné osobnosti současné gestalt terapie z Česka, Evropy i zámoří. Celý seznam přednášek, workshopů a doprovodného programu najdete na samostatné stránce.</p>
      </SectionHead>
      <ul class="keynotes">
        {KEYNOTES.map((k, i) => (
          <li data-reveal style={`--i:${i}`}>
            <a href={`/setkani-v-pohybu/prezentujici/#${k.name.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\s+/g, '-')}`}>
              <img src={k.img} alt={k.name} loading="lazy" width="200" height="200" />
              <span class="kn">{k.name}</span>
              <span class="kc">{k.country}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="actions" data-reveal>
        <a class="btn" href="/setkani-v-pohybu/prezentujici/">Všichni prezentující <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- REGISTRACE -->
  <section class="section" id="registrace">
    <div class="wrap">
      <SectionHead eyebrow="Registrace a ubytování" title="Registrace">
        <p class="muted">Tlačítko registrace pro členy ČSGT aktivujeme 22. listopadu ve 12:00.</p>
      </SectionHead>
      <div class="grid grid-2">
        <div data-reveal>
          <h3>Termíny registrace</h3>
          <ul class="dates">
            <li><b>1.–8. 11. 2026</b><span>předregistrace aktivních účastníků</span></li>
            <li><b>22.–29. 11. 2026</b><span>předregistrace členů ČSGT (od 22. 11. 12:00 do 29. 11. 12:00)</span></li>
            <li><b>30. 11. 2026 – 31. 1. 2027</b><span>včasná registrace (od 30. 11. 12:00 do 31. 1. 12:00)</span></li>
            <li><b>1. 2. – 15. 3. 2027</b><span>registrace</span></li>
          </ul>
        </div>
        <div data-reveal style="--i:1">
          <h3>Registrační poplatek</h3>
          <table class="prices">
            <tbody>
              <tr><td>Včasná registrace<br /><span class="muted">30. 11. 2026 – 31. 1. 2027</span></td><td>9 200 Kč</td></tr>
              <tr><td>Registrace<br /><span class="muted">1. 2. – 15. 3. 2027</span></td><td>10 200 Kč</td></tr>
              <tr><td>Doprovodná osoba<br /><span class="muted">vše kromě odborného programu</span></td><td>3 600 Kč</td></tr>
              <tr><td>Sleva – aktivní účastník</td><td>od 500 Kč</td></tr>
              <tr><td>Sleva – člen ČSGT</td><td>500 Kč</td></tr>
            </tbody>
          </table>
          <p class="small muted">Ceny jsou včetně DPH 21 %. Skupinové registrace: <a href="mailto:info@setkanivpohybu.cz">info@setkanivpohybu.cz</a>.</p>
        </div>
      </div>

      <div class="grid grid-2 more-info">
        <div class="card" data-reveal>
          <h3>Poplatek zahrnuje</h3>
          <ul>
            <li>odborný program – 4 dny, přibližně 30 vzdělávacích hodin</li>
            <li>doprovodný program včetně tří večerních programů</li>
            <li>6 kávových přestávek</li>
            <li>večeři ve čtvrtek, oběd a večeři v pátek, oběd a večerní raut v sobotu</li>
            <li>kredity pro vzdělávání</li>
            <li>audiovizuální nahrávku přednášek z hlavního sálu</li>
          </ul>
        </div>
        <div class="card" data-reveal style="--i:1">
          <h3>Slevy pro aktivní účastníky</h3>
          <p class="small">Jeden prezentující má slevu 1 000 Kč za každý svůj samostatný příspěvek. Pokud má příspěvek dva a více prezentujících, má každý z nich slevu 500 Kč. Slevy za jednotlivé příspěvky se sčítají. Aktivní účastník, který je zároveň členem ČSGT, má obě slevy.</p>
          <h3>Platba ze zahraničí</h3>
          <p class="small">Platbu zadejte v CZK a u bankovních poplatků zvolte variantu OUR. Pokud ji vaše banka nenabízí, navyšte platbu o 150 Kč. Případný rozdíl doplatíte při registraci na místě.</p>
        </div>
      </div>

      <div class="hotels" data-reveal>
        <h3>Ubytování v Táboře</h3>
        <p class="muted">Pro účastníky jsme předběžně rezervovali kapacity v následujících hotelech (do 31. 1. 2027). Rezervaci si zajišťujete sami přímo v hotelu s heslem <strong>„Setkání v pohybu“</strong>. Ceny jsou za noc včetně snídaně; poplatek z ubytování 21 Kč/os./noc není zahrnut.</p>
        {hotels.map((h) => (
          <details class="fold">
            <summary>{h.name}</summary>
            <div class="fold-body small">
              <p>{h.contact}</p>
              {h.price && <p class="muted">{h.price}</p>}
              <p><a href={h.url} target="_blank" rel="noopener">Web hotelu ↗</a></p>
            </div>
          </details>
        ))}
        <p class="small muted" style="margin-top:1rem">Další možnosti: <a href="https://www.visittabor.eu/ubytovani" target="_blank" rel="noopener">visittabor.eu</a>, Booking, Airbnb (bez předem rezervované kapacity). Hotel Tábor ukončil činnost, ubytování v něm již není možné.</p>
      </div>
    </div>
  </section>

  <!-- PROGRAM -->
  <section class="section tint" id="program">
    <div class="wrap split">
      <SectionHead eyebrow="Program" title="Program a akreditace">
        <div class="actions">
          <a class="btn" href={m.pdfSetkani} target="_blank" rel="noopener">Program ke stažení (PDF)</a>
          <a class="btn ghost" href="/setkani-v-pohybu/prezentujici/">Anotace příspěvků</a>
        </div>
      </SectionHead>
      <div data-reveal style="--i:1">
        <p>Organizátoři požádali o akreditaci u AKP ČR a ČLK JEP. Celkový rozsah odborného programu je 23 vzdělávacích hodin.</p>
        <h4>Česká lékařská komora (ČLK JEP)</h4>
        <p class="muted">Odborný garant: MUDr. Martin Černý, Ph.D. Akce je pořádána v souladu se Stavovským předpisem ČLK č. 16 a je ohodnocena 24 kredity za pasivní účast. Kredity za aktivní účast budou přednášejícím připsány zpětně.</p>
        <h4>Asociace klinických psychologů ČR (AKP ČR)</h4>
        <p class="muted">Odborná garantka: PhDr. Alena Špirková. Akce je ohodnocena 12 kredity za pasivní účast. Za aktivní účast se připočítává 10 kreditů při jednom autorovi, 5 kreditů při spoluautorství.</p>
        <p class="small muted">Příjem abstraktů je uzavřen, kapacita aktivní účasti byla naplněna. Děkujeme všem za zaslané příspěvky.</p>
      </div>
    </div>
  </section>

  <!-- INFORMACE -->
  <section class="section" id="informace">
    <div class="wrap split">
      <SectionHead eyebrow="Informace" title="Časté otázky" />
      <div data-reveal style="--i:1">
        {faq.map(([q, a]) => (
          <details class="fold">
            <summary>{q}</summary>
            <div class="fold-body" set:html={a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- PARTNEŘI -->
  <section class="section tint" id="partneri">
    <div class="wrap">
      <SectionHead eyebrow="Partneři" title="Partneři konference" />
      <div class="logos" data-reveal>
        {partners.map((p) => <a href={p.url} target="_blank" rel="noopener" title={p.name}><img src={p.img} alt={p.name} loading="lazy" /></a>)}
      </div>
    </div>
  </section>

  <!-- O NÁS -->
  <section class="section" id="o-nas">
    <div class="wrap">
      <SectionHead eyebrow="O nás" title="Kdo konferenci připravuje">
        <p class="muted">Konferenci pořádají společně čtyři české instituty – Dialog, Gestalt Praha, Gestalt Studia a Instep – pod záštitou České společnosti pro gestalt terapii (ČSGT). Organizačně ji zajišťuje Evera Agency.</p>
      </SectionHead>
      <div class="logos" data-reveal>
        {institutes.map((p) => <a href={p.url} target="_blank" rel="noopener" title={p.name}><img src={p.img} alt={p.name} loading="lazy" /></a>)}
        <a href="https://csgt.cz" target="_blank" rel="noopener" title="ČSGT"><img src={m.oCSGT} alt="ČSGT – Česká společnost pro gestalt terapii" loading="lazy" /></a>
      </div>

      <h3 class="sub">Organizační tým</h3>
      <div class="grid grid-2">
        {lide.tym.map((p, i) => (
          <div class="person" data-reveal style={`--i:${i % 2}`}>
            <img src={teamImg[p.name]} alt={p.name} loading="lazy" width="110" height="110" />
            <div><h4>{p.name}</h4><p class="small muted">{p.bio}</p></div>
          </div>
        ))}
      </div>

      <h3 class="sub">Odborný výbor</h3>
      <div class="committee" data-reveal>
        {lide.vybor.map((p) => (
          <details class="fold">
            <summary>{p.name}</summary>
            <div class="fold-body small muted"><p>{p.bio}</p></div>
          </details>
        ))}
      </div>

      <div class="grid grid-2 contact-cards">
        <div class="card" data-reveal>
          <h3>Kontakt</h3>
          <p>Organizační i odborné dotazy<br /><a href="mailto:info@setkanivpohybu.cz">info@setkanivpohybu.cz</a><br /><a href="tel:+420731573668">+420 731 573 668</a></p>
        </div>
        <div class="card" data-reveal style="--i:1">
          <h3>Organizátor</h3>
          <p class="small">Evera Agency s.r.o. – Veronika Fišerová a Karel Fišer<br />Branická 230/115, 147 00 Praha 4 · IČO 22547827<br /><a href="/">evera.cz</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- OZVĚNY 2024 -->
  <section class="section tint" id="foto">
    <div class="wrap">
      <SectionHead eyebrow="Ohlédnutí" title="Ozvěny konference Gestalt lásky 2024" />
      <div class="photos" data-reveal>
        <img src={m.sp1} alt="Gestalt lásky 2024" loading="lazy" />
        <img src={m.eveAbout1} alt="Gestalt lásky 2024" loading="lazy" />
        <img src={m.sp4} alt="Gestalt lásky 2024" loading="lazy" />
      </div>
      <div class="actions" data-reveal>
        <a class="btn ghost" href="https://www.youtube.com/watch?v=llTs-x6PPYc" target="_blank" rel="noopener">Video 2024 ↗</a>
        <a class="btn ghost" href={m.pdfLasky} target="_blank" rel="noopener">Program 2024 (PDF)</a>
        <a class="btn ghost" href={m.pdfLaskySbornik} target="_blank" rel="noopener">Sborník abstraktů 2024 (PDF)</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .topics-title { margin-top: clamp(2.5rem, 5vw, 3.5rem); }
  .topics { display: flex; flex-direction: column; gap: clamp(1.25rem, 2.5vw, 2rem); }
  .topic { display: grid; grid-template-columns: 1.5rem minmax(0, 1fr); column-gap: 1rem; align-items: baseline; }
  .topic .dot { grid-row: span 2; width: 0.8rem; height: 0.8rem; border-radius: 50%; background: var(--accent); animation: pulse 3.5s ease-in-out infinite; align-self: start; margin-top: 0.5em; }
  .topic:nth-child(even) .dot { background: var(--accent-2); animation-delay: 1.2s; }
  @keyframes pulse { 50% { transform: scale(1.35); opacity: 0.75; } }
  .topic h4 { margin: 0 0 0.2rem; }
  .topic p { margin: 0; }
  @media (min-width: 900px) {
    .topic { grid-template-columns: 1.5rem minmax(0, 20rem) minmax(0, 1fr); }
    .topic .dot { grid-row: auto; }
    .topic h4 { margin: 0; }
  }

  .photos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin-top: clamp(2rem, 5vw, 3rem); }
  .photos img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (max-width: 600px) { .photos { grid-template-columns: 1fr 1fr; } .photos img:last-child { display: none; } }

  .keynotes { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.5rem 1rem; grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); }
  .keynotes li { margin: 0; }
  .keynotes a { display: flex; flex-direction: column; align-items: center; text-align: center; text-decoration: none; }
  .keynotes img {
    width: 8.5rem; height: 8.5rem; border-radius: 50%; object-fit: cover; margin-bottom: 0.8rem;
    box-shadow: 0 0 0 0 var(--accent); transition: box-shadow 0.5s var(--ease), transform 0.5s var(--ease);
  }
  .keynotes a:hover img { box-shadow: 0 0 0 5px var(--accent); transform: scale(1.03); }
  .kn { font-weight: 650; line-height: 1.3; }
  .kc { font-size: var(--fs-sm); color: var(--ink-soft); }

  .more-info, .contact-cards { margin-top: clamp(3rem, 6vw, 5rem); }
  .card h3 + p, .card ul { margin-bottom: 1.25rem; }
  .hotels { margin-top: clamp(2.5rem, 5vw, 3.5rem); max-width: 50rem; }

  :global(main) h3.sub { margin-top: clamp(4rem, 8vw, 6rem); margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
  .committee { columns: 2 22rem; column-gap: 2.5rem; }
  .committee details { break-inside: avoid; }
  .logos { margin-bottom: 0.5rem; }
</style>

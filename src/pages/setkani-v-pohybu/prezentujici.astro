---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import Bubbles from '../../components/Bubbles.astro';
import '../../styles/setkani.css';
import m from '../../data/media.json';
import items from '../../data/setkani-prispevky.json';
import { NAV, KEYNOTES, EMAIL } from '../../data/setkani';

const slug = (s: string) =>
  s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// zachová pořadí kategorií ze zdroje
const cats: { name: string; id: string; items: typeof items }[] = [];
for (const it of items) {
  let c = cats.find((x) => x.name === it.cat);
  if (!c) { c = { name: it.cat, id: slug(it.cat), items: [] }; cats.push(c); }
  c.items.push(it);
}
---
<Base
  title="Prezentující | Gestalt Tábor – Setkání v pohybu 2027"
  description="Hlavní hosté, přednášky, workshopy, open space a doprovodný program 8. konference gestalt psychoterapie Setkání v pohybu."
  theme="setkani"
  nav={NAV}
  logo={m.logoSetkani}
  logoAlt="Gestalt Tábor – Setkání v pohybu"
  homeHref="/setkani-v-pohybu/"
  cta={{ label: 'Registrace', href: '/setkani-v-pohybu/#registrace' }}
  contactEmail={EMAIL}
>
  <section class="phead">
    <div class="wrap hero-in">
      <a class="back small" href="/setkani-v-pohybu/">← Setkání v pohybu</a>
      <h1>Prezentující a jejich příspěvky</h1>
      <p>V roce 2027 přivítá naše konference výrazné osobnosti současné gestalt terapie z Česka, Evropy i zámoří. Setkají se zde terapeuti, lektoři a výzkumníci, kteří dlouhodobě spoluutvářejí podobu psychoterapie ve svých zemích i na mezinárodní scéně.</p>
      <p>Čekají nás přednášky otevírající nové perspektivy, témata rezonující se současným světem i živá setkání s lidmi, kteří propojují odbornou hloubku, lidskost a odvahu hledat nové cesty terapeutické práce.</p>
    </div>
  </section>

  <nav class="chips-bar" aria-label="Kategorie příspěvků">
    <div class="wrap chips">
      <a href="#hlavni-hoste">Hlavní hosté</a>
      {cats.map((c) => <a href={`#${c.id}`}>{c.name} <span>{c.items.length}</span></a>)}
    </div>
  </nav>

  <section class="section" id="hlavni-hoste">
    <Bubbles set={2} />
    <div class="wrap">
      <SectionHead title="Hlavní hosté" />
      <div class="keys">
        {KEYNOTES.map((k, i) => (
          <article class="key" id={slug(k.name)} data-reveal style={`--i:${i % 2}`}>
            <img src={k.img} alt={k.name} loading="lazy" width="260" height="260" />
            <div>
              <h3>{k.name} <span class="country">{k.country}</span></h3>
              <div class="bio">{k.bio.map((p) => <p>{p}</p>)}</div>
              <button class="bio-more" type="button" aria-expanded="false" hidden>Číst dál</button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {cats.map((c, ci) => (
    <section class={`section ${ci % 2 === 0 ? 'tint' : ''}`} id={c.id}>
      <Bubbles set={((ci % 4) + 1) as 1 | 2 | 3 | 4} />
      <div class="wrap">
        <SectionHead title={c.name} />
        <div class="list">
          {c.items.map((it) => (
            <details class="fold talk">
              <summary>
                <span class="t">
                  <span class="tt">{it.title}</span>
                  {it.who && <span class="who">{it.who}</span>}
                </span>
                {it.imgs.length > 0 && (
                  <span class="faces" aria-hidden="true">
                    {it.imgs.slice(0, 4).map((im) => <img src={im.src} alt="" loading="lazy" width="40" height="40" />)}
                  </span>
                )}
              </summary>
              <div class="fold-body talk-body">
                {it.imgs.length > 0 && (
                  <div class="talk-photos">
                    {it.imgs.map((im) => <img src={im.src} alt={im.alt} loading="lazy" width="400" height="400" />)}
                  </div>
                )}
                <div class="talk-text">
                  {it.format && <p class="format">{it.format}</p>}
                  {it.text.map((p) => <p>{p}</p>)}
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="wrap center" data-reveal>
      <h2>Těšíme se na vás v Táboře</h2>
      <p class="muted">6.–9. května 2027</p>
    </div>
  </section>
</Base>

<script>
  // Medailonky hlavních hostů: stejně dlouhá ukázka, zbytek po kliknutí na „Číst dál“
  document.querySelectorAll<HTMLElement>('.key').forEach((key) => {
    const bio = key.querySelector<HTMLElement>('.bio');
    const btn = key.querySelector<HTMLButtonElement>('.bio-more');
    if (!bio || !btn) return;
    if (bio.scrollHeight - bio.clientHeight < 8) { bio.classList.add('full'); return; }
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const open = bio.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Skrýt' : 'Číst dál';
    });
  });
</script>

<style>
  .phead { padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem); }
  .phead p { color: var(--ink-soft); }
  .back { display: inline-block; margin-bottom: 1.5rem; text-decoration: none; color: var(--ink-soft); }

  /* kategorie: kulaté „bubliny“, zalamují se na víc řádků, nic se neschová */
  .chips-bar { background: color-mix(in srgb, var(--paper) 94%, transparent); backdrop-filter: blur(8px); z-index: 40; }
  @media (min-width: 760px) { .chips-bar { position: sticky; top: var(--header-h); } }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; padding-block: 0.75rem; }
  .chips a {
    flex: none; text-decoration: none; font-family: var(--font-display); font-size: 1.05rem; font-weight: 500;
    padding: 0.35rem 1rem; border-radius: 999px; background: #fff; border: 0;
    transition: background 0.3s, color 0.3s;
  }
  .chips a:nth-child(3n + 1):hover { background: var(--accent); color: #fff; }
  .chips a:nth-child(3n + 2):hover { background: var(--accent-2); color: #fff; }
  .chips a:nth-child(3n):hover { background: var(--accent-3); color: var(--ink); }
  .chips a span { opacity: 0.55; margin-left: 0.2em; }
  :global(html) { scroll-padding-top: calc(var(--header-h) + 1rem); }
  @media (min-width: 760px) { :global(html) { scroll-padding-top: calc(var(--header-h) + 7rem); } }

  /* hlavní hosté: fotka nahoře, pod ní stejně dlouhý text */
  .keys { display: grid; gap: clamp(3rem, 6vw, 4rem) clamp(2rem, 4vw, 3rem); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .key { display: flex; flex-direction: column; gap: 1.25rem; }
  .key img { width: 11rem; height: 11rem; border-radius: 50%; object-fit: cover; }
  .key h3 { margin-bottom: 0.75rem !important; }
  .country { font-family: var(--font-body); font-size: var(--fs-sm); color: var(--accent-2); font-weight: 700; margin-left: 0.3rem; white-space: nowrap; }
  .bio { color: var(--ink-soft); max-height: 10.5em; overflow: hidden; position: relative; }
  .bio::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 3.5em; background: linear-gradient(transparent, var(--paper)); pointer-events: none; }
  .bio.open, .bio.full { max-height: none; }
  .bio.open::after, .bio.full::after { display: none; }
  .bio-more { appearance: none; border: 0; background: none; padding: 0; margin-top: 0.5rem; cursor: pointer; font: inherit; font-weight: 700; color: var(--accent); }
  .bio-more:hover { color: var(--accent-2); }

  .talk > summary { align-items: center; }
  .talk .t { display: flex; flex-direction: column; gap: 0.2rem; flex: 1; }
  .talk .tt { font-family: var(--font-display); font-weight: 500; font-size: 1.3rem; line-height: 1.3; }
  .talk .who { font-size: var(--fs-sm); color: var(--ink-soft); font-weight: 400; }
  .faces { display: flex; flex: none; }
  .faces img { width: 2.75rem; height: 2.75rem; border-radius: 50%; object-fit: cover; border: 2px solid var(--paper); margin-left: -0.6rem; background: var(--paper-2); }
  .tint .faces img { border-color: var(--paper-2); }
  .faces img:first-child { margin-left: 0; }
  @media (max-width: 520px) { .faces { display: none; } }
  .talk[open] .faces { visibility: hidden; }
  /* anotace: nejdřív větší fotky prezentujících, pod nimi text */
  .talk-body { display: flex; flex-direction: column; gap: 1.5rem; color: var(--ink-soft); }
  .talk-photos { display: flex; flex-wrap: wrap; gap: 1rem; }
  .talk-photos img { width: 13rem; height: 13rem; border-radius: 50%; object-fit: cover; background: var(--paper-2); }
  @media (max-width: 520px) { .talk-photos img { width: 9rem; height: 9rem; } }
  .format { display: inline-block; font-size: var(--fs-sm); color: var(--ink); background: var(--accent-soft); padding: 0.25rem 0.9rem; border-radius: 999px; }

  .center { text-align: center; }
</style>


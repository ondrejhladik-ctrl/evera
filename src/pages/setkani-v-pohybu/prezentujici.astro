---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import m from '../../data/media.json';
import items from '../../data/setkani-prispevky.json';
import { NAV, KEYNOTES } from '../../data/setkani';

const slug = (s: string) =>
  s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// zachová pořadí kategorií ze zdroje
const cats: { name: string; id: string; items: typeof items }[] = [];
for (const it of items) {
  let c = cats.find((x) => x.name === it.cat);
  if (!c) { c = { name: it.cat, id: slug(it.cat), items: [] }; cats.push(c); }
  c.items.push(it);
}
---
<Base
  title="Prezentující | Gestalt Tábor – Setkání v pohybu 2027"
  description="Hlavní hosté, přednášky, workshopy, open space a doprovodný program 8. konference gestalt psychoterapie Setkání v pohybu."
  theme="setkani"
  nav={NAV}
  logo={m.logoSetkani}
  logoAlt="Gestalt Tábor – Setkání v pohybu"
  homeHref="/setkani-v-pohybu/"
  cta={{ label: 'Registrace', href: '/setkani-v-pohybu/#registrace' }}
>
  <section class="phead">
    <div class="wrap hero-in">
      <a class="back small" href="/setkani-v-pohybu/">← Setkání v pohybu</a>
      <h1>Lidé a příspěvky konference</h1>
      <p class="lede">V roce 2027 přivítá naše konference výrazné osobnosti současné gestalt terapie z Česka, Evropy i zámoří – terapeuty, lektory a výzkumníky, kteří dlouhodobě spoluutvářejí podobu psychoterapie ve svých zemích i na mezinárodní scéně.</p>
    </div>
  </section>

  <nav class="chips-bar" aria-label="Kategorie příspěvků">
    <div class="wrap chips">
      <a href="#hlavni-hoste">Hlavní hosté</a>
      {cats.map((c) => <a href={`#${c.id}`}>{c.name} <span>{c.items.length}</span></a>)}
    </div>
  </nav>

  <section class="section" id="hlavni-hoste">
    <div class="wrap">
      <SectionHead eyebrow="Keynote speakers" title="Hlavní hosté" />
      <div class="keys">
        {KEYNOTES.map((k, i) => (
          <article class="key" id={slug(k.name)} data-reveal style={`--i:${i % 2}`}>
            <img src={k.img} alt={k.name} loading="lazy" width="260" height="260" />
            <div>
              <h3>{k.name} <span class="country">{k.country}</span></h3>
              {k.bio.map((p) => <p class="small muted">{p}</p>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {cats.map((c, ci) => (
    <section class={`section ${ci % 2 === 0 ? 'tint' : ''}`} id={c.id}>
      <div class="wrap">
        <SectionHead title={c.name}>
          <p class="muted small">{c.items.length} {c.items.length === 1 ? 'příspěvek' : c.items.length < 5 ? 'příspěvky' : 'příspěvků'} · kliknutím rozbalíte anotaci</p>
        </SectionHead>
        <div class="list">
          {c.items.map((it) => (
            <details class="fold talk">
              <summary>
                <span class="t">
                  <span class="tt">{it.title}</span>
                  {it.who && <span class="who">{it.who}</span>}
                </span>
                {it.imgs.length > 0 && (
                  <span class="faces" aria-hidden="true">
                    {it.imgs.slice(0, 4).map((im) => <img src={im.src} alt="" loading="lazy" width="40" height="40" />)}
                  </span>
                )}
              </summary>
              <div class="fold-body">
                {it.format && <p class="format">{it.format}</p>}
                {it.text.map((p) => <p>{p}</p>)}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="wrap center" data-reveal>
      <h2>Těšíme se na vás v Táboře</h2>
      <p class="muted">6.–9. května 2027</p>
      <div class="actions center-actions">
        <a class="btn" href="/setkani-v-pohybu/#registrace">Registrace <span class="arrow">→</span></a>
        <a class="btn ghost" href={m.pdfSetkani} target="_blank" rel="noopener">Program (PDF)</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .phead { padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem); }
  .phead h1 { max-width: 16ch; }
  .back { display: inline-block; margin-bottom: 1.5rem; text-decoration: none; color: var(--ink-soft); }

  .chips-bar { position: sticky; top: var(--header-h); z-index: 40; background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(8px); }
  .chips { display: flex; gap: 0.5rem; overflow-x: auto; padding-block: 0.75rem; scrollbar-width: none; }
  .chips::-webkit-scrollbar { display: none; }
  .chips a {
    flex: none; text-decoration: none; font-size: var(--fs-sm); font-weight: 550;
    padding: 0.45rem 0.9rem; border-radius: 0.25rem; background: #fff; border: 1px solid var(--line);
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }
  .chips a:hover { background: var(--accent); color: #fff; border-color: var(--accent); }
  .chips a span { opacity: 0.55; margin-left: 0.2em; }
  :global(html) { scroll-padding-top: calc(var(--header-h) + 4rem); }

  .keys { display: grid; gap: clamp(2rem, 4vw, 3rem); grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr)); }
  .key { display: grid; grid-template-columns: 1fr; gap: 1.25rem; align-items: start; }
  @media (min-width: 560px) { .key { grid-template-columns: 8.5rem 1fr; } }
  .key img { width: 8.5rem; height: 8.5rem; border-radius: 50%; object-fit: cover; }
  .key h3 { margin-bottom: 0.5rem; }
  .country { font-family: var(--font-body); font-size: var(--fs-sm); color: var(--accent); font-weight: 600; margin-left: 0.3rem; white-space: nowrap; }

  .list { max-width: 54rem; }
  .talk > summary { align-items: center; }
  .talk .t { display: flex; flex-direction: column; gap: 0.2rem; flex: 1; }
  .talk .tt { font-family: var(--font-display); font-weight: 450; font-size: var(--fs-lg); line-height: 1.3; }
  .talk .who { font-weight: 500; font-size: var(--fs-sm); color: var(--ink-soft); }
  .faces { display: flex; flex: none; }
  .faces img { width: 2.5rem; height: 2.5rem; border-radius: 50%; object-fit: cover; border: 2px solid var(--paper); margin-left: -0.6rem; background: var(--paper-2); }
  .tint .faces img { border-color: var(--paper-2); }
  .faces img:first-child { margin-left: 0; }
  @media (max-width: 520px) { .faces { display: none; } }
  .talk .fold-body { max-width: 46rem; color: var(--ink-soft); }
  .format { display: inline-block; font-size: var(--fs-sm); font-weight: 500; color: var(--ink); background: var(--accent-soft); padding: 0.25rem 0.7rem; border-radius: 0.25rem; }

  .center { text-align: center; }
  .center-actions { justify-content: center; }
</style>

---
import Base from '../layouts/Base.astro';
import m from '../data/media.json';
import InquiryForm from '../components/InquiryForm.astro';

const people = [
  {
    img: m.veronika,
    name: 'Veronika Fišerová, DiS.',
    role: 'ředitelka a zakladatelka',
    bio: 'Založila a vede kongresovou a incomingovou agenturu Evera Agency. Je podepsána pod organizací mnoha mezinárodních i českých konferencí (Open Society Found 2005, EECERA 2006, Česká gestalt konference 2016 a 2024 aj.). Je diplomovaná specialistka v oboru management cestovního ruchu, kde působí od roku 1998. V letech 2011–2019 založila a vedla sociální podnik Fair Food Club. Za pandemie covidu se rekvalifikovala na pracovnici v sociálních službách a pracovala jako asistentka dětí s kombinovaným handicapem.',
  },
  {
    img: m.karel,
    name: 'Bc. Karel Fišer',
    role: 'výkonný ředitel a zakladatel',
    bio: 'Spoluzakladatel agentury Evera Agency. Vystudoval FHS UK v Praze, má za sebou spoustu humanitární práce (projekt OSN pro uprchlíky, projekt Help povodně 2002 aj.). Jako organizátor a PR manažer má na kontě stovky akcí (např. Nadace D. a V. Havlových VIZE 97). Je členem ČAP, absolvoval mj. výcvik v integrativní gestalt psychoterapii. Od roku 2013 působí jako psychoterapeut v pražském Programu Pilot a provozuje vlastní praxi.',
  },
];
---
<Base title="Evera – kongresy a konference, které dávají smysl" header="over" preloader>
  <!-- HERO -->
  <section class="xhero">
    <img class="xhero-bg" src={m.eveHero} srcset={`/media/2023/06/DSC_0579-2-900.webp 900w, ${m.eveHero} 1920w`} sizes="100vw" alt="" width="1920" height="1280" fetchpriority="high" decoding="async" />
    <div class="wrap xhero-inner">
      <h1 class="xhero-title">
        <span class="line"><span>Vaše téma.</span></span>
        <span class="line"><span class="serif">Naše zkušenost.</span></span>
        <span class="line"><span>Společný smysl.</span></span>
      </h1>
    </div>
  </section>

  <!-- KONFERENCE 2027 – karty se na sebe skládají při scrollu -->
  <section class="konf" id="konference">
    <div class="wrap">
      <h2 class="konf-title" data-title>Kam se chystáme <span class="serif">v roce 2027</span></h2>
      <div class="stack">
        <a class="stack-card" href="/setkani-v-pohybu/" style="--i:0">
          <span class="sc-text">
            <span class="p-tag">Gestalt Tábor 2027</span>
            <span class="p-body">
              <span class="p-kicker">8. konference gestalt psychoterapie</span>
              <span class="p-title">Setkání v pohybu</span>
              <span class="p-meta"><span>6.–9. května 2027</span><span>Tábor</span></span>
            </span>
            <span class="p-go" aria-hidden="true">→</span>
          </span>
          <span class="sc-media p-setkani">
            <span class="bubbles" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
          </span>
        </a>
        <a class="stack-card" href="/kondept2/" style="--i:1">
          <span class="sc-text">
            <span class="p-tag">Kondept 2027</span>
            <span class="p-body">
              <span class="p-kicker">Metody – vztah – rodina – sebepéče</span>
              <span class="p-title">2. česká konference dětské psychoterapie</span>
              <span class="p-meta"><span>30. září – 2. října 2027</span><span>Kongres Hotel Jezerka, Seč</span></span>
            </span>
            <span class="p-go" aria-hidden="true">→</span>
          </span>
          <span class="sc-media p-kondept">
            <img src={m.heroKondept} alt="" loading="lazy" width="1200" height="669" />
          </span>
        </a>
      </div>
    </div>
  </section>
  <!-- O NÁS -->
  <section class="section" id="o-nas">
    <div class="wrap about">
      <div>
        <h2 data-title>Kongresy a konference, které dávají smysl</h2>
      </div>
      <div class="prose" data-reveal style="--i:1">
        <p class="lede">Stojíme za prestižními českými i mezinárodními konferencemi a kongresy, kde se potkává špičkový obsah, precizní organizace a lidský přístup.</p>
        <p>Za dobu našeho působení jsme realizovali desítky konferencí – od komorních odborných setkání až po rozsáhlé mezinárodní kongresy. Spolupracujeme s významnými českými i zahraničními institucemi, profesními organizacemi, terapeuty, akademiky i neziskovým sektorem. Každou akci chápeme jako jedinečný živý organismus, který si zaslouží citlivý přístup, precizní organizaci a respekt k hodnotám oboru.</p>
        <p>Naší silnou stránkou je hluboké porozumění tématům psychologie a psychoterapie. Víme, že odborný obsah, bezpečný prostor a kvalitní lidské setkání jsou stejně důležité jako bezchybná logistika, technické zajištění a profesionální komunikace.</p>
        <p>Evera není jen organizační agentura. Jsme partnerem, který naslouchá, přemýšlí v souvislostech a pomáhá proměňovat vize v dobře fungující a smysluplné události.</p>
      </div>
    </div>
    <div class="wrap pillars">
      <h2 class="pillars-title" data-title>Proč připravit konferenci s Everou</h2>
      {[
        ['Odborný obsah', 'Rozumíme oboru, ve kterém akce vzniká, a mluvíme řečí jeho lidí.'],
        ['Bezpečný prostor', 'Vytváříme prostředí, kde se lidé mohou skutečně potkat.'],
        ['Precizní organizace', 'Logistika, technika, registrace i komunikace pod jednou střechou.'],
      ].map(([t, d], i) => (
        <div class="pillar" data-reveal style={`--i:${i}`}>
          <span class="num">0{i + 1}</span>
          <h3>{t}</h3>
          <p class="muted">{d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- KDO JSME -->
  <section class="section" id="kdo-jsme">
    <div class="wrap">
      <div data-reveal>
        <h2 data-title>Kdo jsme</h2>
      </div>
      <div class="grid grid-2">
        {people.map((p, i) => (
          <article class="card person big" data-reveal style={`--i:${i}`}>
            <span class="pimg"><img src={p.img} alt={p.name} loading="lazy" width="200" height="200" /></span>
            <div>
              <h3>{p.name}</h3>
              <p class="role">{p.role}, Evera Agency</p>
              <p class="small muted">{p.bio}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- KONTAKT -->
  <section class="section contact" id="kontakt">
    <div class="wrap">
      <div class="contact-head">
        <h2 data-title>Pojďme spolu připravit vaši konferenci</h2>
        <p class="muted" data-reveal>Ozvěte se nám – rádi se potkáme a probereme, co potřebujete.</p>
      </div>
      <InquiryForm />
    </div>
  </section>
</Base>

<script>
  // Karty konferencí: spodní karta se při najíždění další jemně zmenší a ztmaví
  const cards = [...document.querySelectorAll<HTMLElement>('.stack-card')];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  let ticking = false;
  // Úvod: paralaxa fotky a jemné odjetí nadpisu
  const heroBg = document.querySelector<HTMLElement>('.xhero-bg');
  const heroTitle = document.querySelector<HTMLElement>('.xhero-title');
  const update = () => {
    ticking = false;
    if (!reduce && heroBg && heroTitle) {
      const y = window.scrollY, vh = window.innerHeight;
      if (y < vh * 1.2) {
        heroBg.style.translate = `0 ${(y * 0.3).toFixed(1)}px`;
        heroTitle.style.translate = `0 ${(y * -0.12).toFixed(1)}px`;
        heroTitle.style.opacity = String(Math.max(0, 1 - y / (vh * 0.75)).toFixed(3));
      }
    }
    const off = reduce || window.innerWidth <= 900;
    for (let i = 0; i < cards.length - 1; i++) {
      const card = cards[i];
      if (off) { card.style.transform = ''; card.style.setProperty('--dim', '0'); continue; }
      const a = card.getBoundingClientRect();
      const b = cards[i + 1].getBoundingClientRect();
      const p = clamp(1 - (b.top - a.top) / a.height);
      card.style.transform = `scale(${(1 - p * 0.05).toFixed(4)})`;
      card.style.setProperty('--dim', p.toFixed(3));
    }
  };
  const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  update();
</script>

<style>
  /* ===== HERO ===== */
  .xhero {
    position: relative; min-height: 100svh; overflow: hidden; color: #fff;
    background: #0f2a33; display: flex; align-items: flex-end;
  }
  .xhero-bg {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    animation: slowzoom 18s var(--ease) both;
  }
  @keyframes slowzoom { from { transform: scale(1.08); } }
  .xhero::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(180deg, rgba(10, 25, 30, 0.45) 0%, rgba(10, 25, 30, 0) 22%),
      linear-gradient(90deg, rgba(10, 25, 30, 0.78) 0%, rgba(10, 25, 30, 0.45) 45%, rgba(10, 25, 30, 0.05) 85%),
      linear-gradient(0deg, rgba(10, 25, 30, 0.85) 0%, rgba(10, 25, 30, 0) 40%);
  }
  .xhero-inner { position: relative; z-index: 2; padding-block: 7rem clamp(1.5rem, 4vw, 3rem); }
  .xhero-title {
    font-size: clamp(2.8rem, min(6.6vw, 12.5vh), 7.5rem); line-height: 0.98; letter-spacing: -0.035em;
    font-weight: 600; margin: 0 0 clamp(2.5rem, 8vh, 5rem);
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.25);
  }
  .xhero-title .line { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .xhero-title .line > span { display: inline-block; animation: lineup 1.1s var(--ease) both; }
  .xhero-title .line:nth-child(2) > span { animation-delay: 0.12s; }
  .xhero-title .line:nth-child(3) > span { animation-delay: 0.24s; }
  .xhero-title .serif { color: #f4a68e; font-weight: 300; }
  @keyframes lineup { from { transform: translateY(105%); } }
  /* když běží preloader, úvod se rozehraje až po jeho odjetí */
  :global(html.pre-on) .xhero-title .line > span { animation-delay: 3.75s; }
  :global(html.pre-on) .xhero-title .line:nth-child(2) > span { animation-delay: 3.87s; }
  :global(html.pre-on) .xhero-title .line:nth-child(3) > span { animation-delay: 3.99s; }
  :global(html.pre-on) .xhero-bg { animation-delay: 3.4s; }

  /* ===== KONFERENCE – karty skládané při scrollu ===== */
  .konf { background: var(--ink); color: #fff; padding-block: clamp(4rem, 9vw, 7rem); }
  .konf-title { font-size: var(--fs-3xl); max-width: 14ch; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .konf-title .serif { color: #f4a68e; }
  .stack { display: block; }
  .stack-card {
    position: sticky; top: calc(var(--header-h) + 0.75rem + var(--i) * 1.25rem);
    display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 2vw, 2rem);
    height: min(66vh, 38rem); margin-bottom: 8vh; padding: clamp(1rem, 2vw, 1.75rem);
    background: var(--paper); color: var(--ink); text-decoration: none;
    transform-origin: 50% 0; will-change: transform;
  }
  .stack-card:last-child { margin-bottom: 0; }
  .stack-card:hover { color: var(--ink); }
  .stack-card::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    background: var(--ink); opacity: calc(var(--dim, 0) * 0.35);
  }
  .sc-text { position: relative; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(0.75rem, 1.5vw, 1.25rem); }
  .sc-media { position: relative; overflow: hidden; isolation: isolate; }
  .p-tag {
    align-self: flex-start; font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 0.4rem 0.8rem; border-radius: 999px; background: var(--paper-2);
  }
  .p-body { display: flex; flex-direction: column; padding-right: 4.5rem; }
  .p-kicker { font-size: var(--fs-sm); font-weight: 500; color: var(--ink-soft); margin-bottom: 0.6rem; }
  .p-title {
    font-family: var(--font-display); font-weight: 300; line-height: 1.06; letter-spacing: -0.03em;
    font-size: clamp(2rem, 1rem + 2.4vw, 3.25rem); max-width: 16ch; margin-bottom: 1.4rem; text-wrap: balance;
  }
  .p-meta { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; font-size: 1rem; font-weight: 500; }
  .p-meta span + span { color: var(--ink-soft); }
  .p-go {
    position: absolute; right: clamp(0.75rem, 1.5vw, 1.25rem); bottom: clamp(0.75rem, 1.5vw, 1.25rem);
    width: 3.25rem; height: 3.25rem; border-radius: 50%; background: var(--ink); color: #fff;
    display: grid; place-items: center; font-size: 1.3rem; transition: transform 0.6s var(--ease);
  }
  .stack-card:hover .p-go { transform: rotate(-45deg) scale(1.1); }
  @media (max-width: 900px) {
    .stack-card { position: relative; top: auto; height: auto; grid-template-columns: 1fr; margin-bottom: 1.25rem; }
    .sc-media { aspect-ratio: 4 / 3; order: -1; }
    .sc-text { gap: 2rem; }
  }

  /* Setkání v pohybu – kruhy v pohybu */
  .p-setkani { background: #2532e6; }
  .bubbles { position: absolute; inset: 0; z-index: -1; }
  .bubbles i { position: absolute; border-radius: 50%; display: block; transition: transform 1.2s var(--ease); }
  .bubbles i:nth-child(1) { width: 46%; aspect-ratio: 1; background: #ef3e36; right: -10%; top: -12%; animation: orbit 16s ease-in-out infinite; }
  .bubbles i:nth-child(2) { width: 28%; aspect-ratio: 1; background: #9cc3f7; left: 18%; top: 38%; animation: orbit 12s ease-in-out -4s infinite reverse; }
  .bubbles i:nth-child(3) { width: 8%; aspect-ratio: 1; background: #fff; left: 12%; top: 16%; animation: orbit 10s ease-in-out -2s infinite; }
  .bubbles i:nth-child(4) { width: 22%; aspect-ratio: 1; right: 14%; bottom: 12%; background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.75), rgba(255,255,255,.08) 45%, rgba(255,255,255,.18) 70%, rgba(255,255,255,.45)); animation: orbit 18s ease-in-out -6s infinite; }
  .bubbles i:nth-child(5) { width: 6%; aspect-ratio: 1; background: #ef3e36; left: 58%; top: 20%; animation: orbit 9s ease-in-out -1s infinite reverse; }
  .stack-card:hover .bubbles i:nth-child(1) { transform: translate(-10%, 8%) scale(1.06); }
  .stack-card:hover .bubbles i:nth-child(2) { transform: translate(12%, -8%); }
  @keyframes orbit { 33% { translate: 4% -5%; } 66% { translate: -5% 3%; } }

  /* Kondept – fotka */
  .p-kondept { background: #d9661f; }
  .p-kondept img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--ease); }
  .stack-card:hover .p-kondept img { transform: scale(1.05); }

  /* ===== O NÁS ===== */
  .about h2 { max-width: 22ch; margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .about .prose { max-width: 46rem; }
  .prose p { color: var(--ink-soft); font-size: var(--fs-base); max-width: none; }
  .pillars { margin-top: clamp(5rem, 10vw, 9rem); display: flex; flex-direction: column; gap: clamp(1.5rem, 3vw, 2.25rem); }
  .pillars-title { font-size: var(--fs-2xl); max-width: 22ch; margin: 0 0 clamp(0.5rem, 1.5vw, 1.25rem); }
  .pillar { display: grid; grid-template-columns: 3rem minmax(0, 1fr); column-gap: 1rem; align-items: baseline; }
  .pillar .num { grid-row: span 2; font-family: var(--font-display); color: var(--accent); font-size: var(--fs-lg); }
  .pillar h3 { margin: 0 0 0.3rem; font-size: var(--fs-lg); }
  .pillar p { margin: 0; }
  @media (min-width: 900px) {
    .pillar { grid-template-columns: 3rem minmax(0, 20rem) minmax(0, 1fr); }
    .pillar .num { grid-row: auto; }
    .pillar h3 { margin: 0; }
  }

  /* ===== KDO JSME ===== */
  .person.big { grid-template-columns: 1fr; }
  .person.big img { width: 7rem; height: 7rem; }
  .pimg { display: block; width: 7rem; height: 7rem; border-radius: 50%; overflow: hidden; }
  :global(.js) .person .pimg img { transform: scale(1.2); transition: transform 1.6s var(--ease) 0.15s; }
  :global(.js) .person.is-in .pimg img { transform: none; }
  @media (min-width: 560px) { .person.big { grid-template-columns: 7rem 1fr; gap: 1.5rem; } }

  /* ===== KONTAKT ===== */
  .contact-head { margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .contact-head h2 { font-size: var(--fs-2xl); max-width: 20ch; margin-bottom: 0.75rem; }
  .contact-head p { font-size: var(--fs-lg); }
  .contact-grid {
    display: grid; gap: 2rem; margin: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .contact-list { margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .contact-list div { display: flex; flex-wrap: wrap; gap: 0 0.5rem; }
  .contact-list dt { color: var(--ink-soft); }
  .contact-list dd { margin: 0; font-weight: 500; }
  .contact-grid a { text-decoration: none; }
  .contact-grid a:hover { text-decoration: underline; }
</style>
